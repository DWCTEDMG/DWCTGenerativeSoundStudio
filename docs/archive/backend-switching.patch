+#!/usr/bin/env node
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+const rootDir = path.resolve(__dirname, "..");
+
+function usage(exitCode = 0) {
+  const out = exitCode === 0 ? console.log : console.error;
+  out(`Usage:
+  pnpm backend:use external <url>
+  pnpm backend:use local [port]
+
+Examples:
+  pnpm backend:use external http://51.83.197.242:43049
+  pnpm backend:use local 7863
+`);
+  process.exit(exitCode);
+}
+
+function normalizeUrl(rawUrl) {
+  const value = String(rawUrl || "").trim();
+  if (!value) return "";
+  try {
+    const parsed = new URL(value);
+    if (parsed.protocol !== "http:" && parsed.protocol !== "https:") return "";
+    const normalizedPath = parsed.pathname && parsed.pathname !== "/" ? parsed.pathname.replace(/\/+$/, "") : "";
+    return `${parsed.origin}${normalizedPath}`;
+  } catch {
+    return "";
+  }
+}
+
+function normalizePort(rawPort) {
+  const value = Number(String(rawPort || "7863").trim());
+  if (!Number.isInteger(value) || value < 1 || value > 65535) {
+    throw new Error(`Invalid port: ${rawPort}`);
+  }
+  return String(value);
+}
+
+function readJson(filePath) {
+  try {
+    return JSON.parse(fs.readFileSync(filePath, "utf8"));
+  } catch {
+    return {};
+  }
+}
+
+function writeJson(filePath, value) {
+  fs.writeFileSync(filePath, `${JSON.stringify(value, null, 2)}\n`, "utf8");
+}
+
+function readEnvFile(filePath) {
+  try {
+    return fs.readFileSync(filePath, "utf8").replace(/^\uFEFF/, "");
+  } catch {
+    return "";
+  }
+}
+
+function writeEnvValues(filePath, updates) {
+  const existing = readEnvFile(filePath)
+    .split(/\r?\n/)
+    .filter((line) => line.trim());
+  const updateKeys = new Set(Object.keys(updates));
+  const kept = existing.filter((line) => {
+    const match = line.match(/^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=/);
+    return !match || !updateKeys.has(match[1]);
+  });
+  for (const [key, value] of Object.entries(updates)) {
+    kept.push(`${key}=${value}`);
+  }
+  fs.writeFileSync(filePath, `${kept.join("\n")}\n`, "utf8");
+}
+
+const mode = String(process.argv[2] || "").trim().toLowerCase();
+if (!mode || mode === "help" || mode === "--help" || mode === "-h") usage(0);
+
+const launcherEnvPath = path.join(rootDir, "launcher_env.json");
+const runtimeDefaultsPath = path.join(rootDir, "electron-resources", "runtime-defaults.json");
+const envLocalPath = path.join(rootDir, ".env.local");
+
+const launcherEnv = readJson(launcherEnvPath);
+const runtimeDefaults = readJson(runtimeDefaultsPath);
+
+let next;
+if (mode === "external" || mode === "remote" || mode === "vast") {
+  const url = normalizeUrl(process.argv[3]);
+  if (!url) {
+    console.error("External mode requires an http(s) backend URL.");
+    usage(1);
+  }
+  next = {
+    mode: "external",
+    host: "127.0.0.1",
+    port: "7863",
+    url,
+    spawnBackend: "0",
+  };
+} else if (mode === "local" || mode === "managed") {
+  const port = normalizePort(process.argv[3] || "7863");
+  next = {
+    mode: "managed",
+    host: "127.0.0.1",
+    port,
+    url: "",
+    spawnBackend: "1",
+  };
+} else {
+  console.error(`Unknown backend mode: ${mode}`);
+  usage(1);
+}
+
+writeJson(launcherEnvPath, {
+  ...launcherEnv,
+  EDMG_STUDIO_BACKEND_MODE: next.mode,
+  EDMG_STUDIO_BACKEND_HOST: next.host,
+  EDMG_STUDIO_BACKEND_PORT: next.port,
+  EDMG_STUDIO_BACKEND_URL: next.url,
+  EDMG_BACKEND_URL: next.url || `http://${next.host}:${next.port}`,
+  EDMG_STUDIO_SPAWN_BACKEND: next.spawnBackend,
+  EDMG_DIRECTOR_SPAWN: next.mode === "external" ? "0" : (launcherEnv.EDMG_DIRECTOR_SPAWN ?? "0"),
+});
+
+writeJson(runtimeDefaultsPath, {
+  ...runtimeDefaults,
+  backend: {
+    ...(runtimeDefaults.backend && typeof runtimeDefaults.backend === "object" ? runtimeDefaults.backend : {}),
+    host: next.host,
+    port: Number(next.port),
+    url: next.url,
+    spawnBackend: next.spawnBackend !== "0",
+  },
+});
+
+writeEnvValues(envLocalPath, {
+  VITE_EDMG_BACKEND_URL: next.url || `http://${next.host}:${next.port}`,
+  EDMG_STUDIO_BACKEND_MODE: next.mode,
+  EDMG_STUDIO_BACKEND_HOST: next.host,
+  EDMG_STUDIO_BACKEND_PORT: next.port,
+  EDMG_STUDIO_BACKEND_URL: next.url,
+  EDMG_BACKEND_URL: next.url || `http://${next.host}:${next.port}`,
+  EDMG_STUDIO_SPAWN_BACKEND: next.spawnBackend,
+  EDMG_DIRECTOR_SPAWN: next.mode === "external" ? "0" : "0",
+});
+
+console.log(`Configured EDMG Studio backend profile: ${next.mode}`);
+console.log(`Connect URL: ${next.url || `http://${next.host}:${next.port}`}`);
+console.log(`Local bind: ${next.host}:${next.port}`);
+console.log(`Spawn backend: ${next.spawnBackend === "0" ? "no" : "yes"}`);
+console.log(`Updated:\n  ${launcherEnvPath}\n  ${runtimeDefaultsPath}\n  ${envLocalPath}`);
