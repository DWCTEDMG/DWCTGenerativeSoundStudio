# Enhanced Deforum Music Generator configuration
# Copy this file to .env and fill only the values required by your local setup.
# Never commit .env or real credentials.

# API keys (optional; leave blank for offline/local providers)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Server configuration
HOST=127.0.0.1
PORT=7860
WORKERS=4

# Processing limits
MAX_AUDIO_DURATION=600
MAX_CONCURRENT_JOBS=3
ENABLE_GPU=true

# AWS storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
S3_BUCKET=

# Azure storage/model cache (optional)
AZURE_STORAGE_CONNECTION_STRING=
EDMG_AZURE_MODEL_CACHE=false
EDMG_AZURE_STORAGE_ACCOUNT=
EDMG_AZURE_STORAGE_ACCOUNT_URL=
EDMG_AZURE_MODEL_CONTAINER=edmg-model-cache
EDMG_AZURE_MODEL_CACHE_PREFIX=models

# Feature flags
ENABLE_CLOUD_STORAGE=false
ENABLE_MULTITRACK=false
ENABLE_STYLE_TRANSFER=false
ENABLE_WEB_API=true

# Development
DEBUG=false
LOG_LEVEL=INFO
ENABLE_PROFILING=false

# Optional path to 7-Zip CLI (used to extract some .7z archives with BCJ2)
EDMG_7Z_PATH=
