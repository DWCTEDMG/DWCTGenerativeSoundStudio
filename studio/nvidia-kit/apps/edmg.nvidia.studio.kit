[package]
title = "EDMG NVIDIA Studio"
description = "Omniverse Kit proof-of-concept shell for the NVIDIA-first EDMG Studio lane."
version = "0.1.0"

[dependencies]
"omni.kit.uiapp" = {}
"omni.kit.window.stage" = {}
"omni.kit.viewport.window" = {}
"omni.usd" = {}
"edmg.timeline" = {}
"edmg.ai_director" = {}
"edmg.usd_schema" = {}
"edmg.render_queue" = {}

[settings.app]
name = "EDMG NVIDIA Studio"
version = "0.1.0"

[settings.app.exts]
folders = [
  "${app}/../extensions"
]

[settings.edmg.nvidia]
backend_url = "http://127.0.0.1:8000"
sample_stage = "${app}/../sample_projects/audio_reactive_stage/stage.usda"
sample_scene_plan = "${app}/../sample_projects/audio_reactive_stage/scene_plan.json"
