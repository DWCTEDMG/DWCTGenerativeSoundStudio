<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EdmgStudio.WinUI</RootNamespace>
    <AssemblyName>EdmgStudio.WinUI</AssemblyName>
    <ApplicationTitle>EDMG Studio</ApplicationTitle>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(EdmgPackageManifestPath)' == ''">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(EdmgPackageManifestPath)' != ''">MSIX</WindowsPackageType>
    <RequireEdmgPackagedBackend Condition="'$(EdmgPackageManifestPath)' != '' And '$(EdmgAllowBackendlessPackage)' != 'true'">true</RequireEdmgPackagedBackend>
    <RequireEdmgVst3Host Condition="'$(EdmgPackageManifestPath)' != '' And '$(EdmgAllowVst3HostlessPackage)' != 'true'">true</RequireEdmgVst3Host>
    <RequireEdmgVst3Scanner Condition="'$(EdmgPackageManifestPath)' != '' And '$(EdmgAllowVst3HostlessPackage)' != 'true'">true</RequireEdmgVst3Scanner>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);src\**;tests\**;Studio-Local-Signing-*\**;**\*.pfx;**\*.p12;**\*_TemporaryKey.*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Store packaging supplies this property only after the canonical backend
      release-manifest gate has validated the immutable PyInstaller onedir tree.
      Keeping it opt-in prevents multi-gigabyte runtime payloads from entering
      normal developer builds.
    -->
    <AppxManifest Include="$(EdmgPackageManifestPath)" Condition="'$(EdmgPackageManifestPath)' != ''" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\Brand\StudioLogo.png" />
    <Content Include="Assets\Brand\StudioBackground.jpg" />
    <Content Include="Assets\Brand\WorkspaceFlair.jpg" />
    <Content Include="..\edmg-studio\electron-resources\bin\ffmpeg.exe" Condition="Exists('..\edmg-studio\electron-resources\bin\ffmpeg.exe')" Link="bin\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\edmg-studio\electron-resources\bin\ffprobe.exe" Condition="Exists('..\edmg-studio\electron-resources\bin\ffprobe.exe')" Link="bin\ffprobe.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\edmg-studio\electron-resources\bin\FFmpeg-*.txt" Link="bin\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(EdmgPackagedBackendPath)\**\*" Condition="'$(EdmgPackagedBackendPath)' != ''" Exclude="$(EdmgPackagedBackendPath)\_internal\tcl86t.dll;$(EdmgPackagedBackendPath)\_internal\tk86t.dll" Link="backend\%(RecursiveDir)%(Filename)%(Extension)" ExcludeFromResourceIndex="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(EdmgReleaseCandidatePath)" Condition="'$(EdmgReleaseCandidatePath)' != ''" Link="release-candidate.json" ExcludeFromResourceIndex="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(EdmgVst3HostPath)" Condition="'$(EdmgVst3HostPath)' != '' And Exists('$(EdmgVst3HostPath)')" Link="EdmgStudio.Vst3Host.exe" ExcludeFromResourceIndex="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(EdmgVst3ScannerPath)" Condition="'$(EdmgVst3ScannerPath)' != '' And Exists('$(EdmgVst3ScannerPath)')" Link="EdmgStudio.Vst3Scanner.exe" ExcludeFromResourceIndex="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="native\vst3-host\THIRD-PARTY-NOTICES.txt" Link="EdmgStudio.Vst3Host.THIRD-PARTY-NOTICES.txt" ExcludeFromResourceIndex="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateEdmgReleaseCandidate" BeforeTargets="PrepareForBuild" Condition="'$(EdmgPackageManifestPath)' != ''">
    <Error Condition="'$(EdmgReleaseCandidatePath)' == '' Or !Exists('$(EdmgReleaseCandidatePath)')" Text="Packaged builds require EdmgReleaseCandidatePath." />
  </Target>

  <Target Name="ValidateEdmgPackagedBackend" BeforeTargets="PrepareForBuild" Condition="'$(RequireEdmgPackagedBackend)' == 'true'">
    <Error Condition="'$(EdmgPackagedBackendPath)' == ''" Text="RequireEdmgPackagedBackend=true requires EdmgPackagedBackendPath." />
    <Error Condition="!Exists('$(EdmgPackagedBackendPath)\backend-bundle-manifest.json')" Text="The packaged backend release manifest is missing." />
    <Error Condition="!Exists('$(EdmgPackagedBackendPath)\edmg-studio-backend.exe')" Text="The packaged backend executable is missing." />
    <Error Condition="!Exists('$(EdmgPackagedBackendPath)\_internal')" Text="The packaged backend onedir runtime directory is missing." />
  </Target>

  <Target Name="ValidateEdmgVst3Host" BeforeTargets="PrepareForBuild" Condition="'$(RequireEdmgVst3Host)' == 'true'">
    <Error Condition="'$(EdmgVst3HostPath)' == '' Or !Exists('$(EdmgVst3HostPath)')" Text="Packaged builds require EdmgVst3HostPath pointing to EdmgStudio.Vst3Host.exe." />
  </Target>

  <Target Name="ValidateEdmgVst3Scanner" BeforeTargets="PrepareForBuild" Condition="'$(RequireEdmgVst3Scanner)' == 'true'">
    <Error Condition="'$(EdmgVst3ScannerPath)' == '' Or !Exists('$(EdmgVst3ScannerPath)')" Text="Packaged builds require EdmgVst3ScannerPath pointing to EdmgStudio.Vst3Scanner.exe." />
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.WinUI" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src\EdmgStudio.Core\EdmgStudio.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Stability-first publish settings while the WinUI startup crash is resolved. -->
  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
