                                            Style="{StaticResource AccentButtonStyle}"
                                            AutomationProperties.AutomationId="AssembleVideoButton" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Exports &amp; Assets"
                             IsClosable="False"
                             AutomationProperties.AutomationId="ExportsAssetsTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="4,12,12,12" Spacing="12">
                            <Expander Header="Deforum export"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="DeforumExportExpander">
                                <StackPanel Padding="12" Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Variant" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="DeforumVariantBox" Value="0"
                                                       AutomationProperties.AutomationId="DeforumVariantBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="FPS" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="DeforumFpsBox" Value="30"
                                                       AutomationProperties.AutomationId="DeforumFpsBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Preset" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="DeforumPresetComboBox" SelectedIndex="0"
                                                      AutomationProperties.AutomationId="DeforumPresetComboBox">
                                                <ComboBoxItem Content="cinematic" />
                                                <ComboBoxItem Content="psychedelic" />
                                                <ComboBoxItem Content="ambient" />
                                                <ComboBoxItem Content="narrative" />
                                                <ComboBoxItem Content="performance" />
                                                <ComboBoxItem Content="abstract" />
                                                <ComboBoxItem Content="lyric" />
                                                <ComboBoxItem Content="product" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <StackPanel Width="180" Spacing="4">
                                            <TextBlock Text="Width" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="DeforumWidthBox" Value="1024"
                                                       AutomationProperties.AutomationId="DeforumWidthBox" />
                                        </StackPanel>
                                        <StackPanel Width="180" Spacing="4">
                                            <TextBlock Text="Height" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="DeforumHeightBox" Value="576"
                                                       AutomationProperties.AutomationId="DeforumHeightBox" />
                                        </StackPanel>
                                        <StackPanel Width="180" Spacing="4">
                                            <TextBlock Text="Sensitivity" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="DeforumSensitivityBox" Value="1" Minimum="0.1" Maximum="3" SmallChange="0.1"
                                                       AutomationProperties.AutomationId="DeforumSensitivityBox" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Content="Export Deforum"
                                            HorizontalAlignment="Left"
                                            Click="ExportDeforum_Click"
                                            AutomationProperties.AutomationId="ExportDeforumButton" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="ComfyUI workflow export"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="ComfyUiExportExpander">
                                <StackPanel Padding="12" Spacing="12">
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Variant" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="ComfyExportVariantBox" Value="0"
                                                       AutomationProperties.AutomationId="ComfyExportVariantBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Model ID" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="ComfyExportModelBox" AutomationProperties.AutomationId="ComfyExportModelBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Workflow family" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="ComfyExportFamilyComboBox" SelectedIndex="0"
                                                      AutomationProperties.AutomationId="ComfyExportFamilyComboBox">
                                                <ComboBoxItem Content="auto" />
                                                <ComboBoxItem Content="txt2img" />
                                                <ComboBoxItem Content="img2img" />
                                                <ComboBoxItem Content="inpaint" />
                                                <ComboBoxItem Content="outpaint" />
                                                <ComboBoxItem Content="controlnet" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock Text="Source asset" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="ComfyExportSourceBox" AutomationProperties.AutomationId="ComfyExportSourceBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Reference asset" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="ComfyExportReferenceBox" AutomationProperties.AutomationId="ComfyExportReferenceBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Inpaint mask" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="ComfyExportMaskBox" AutomationProperties.AutomationId="ComfyExportMaskBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="4">
                                            <TextBlock Text="Width" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="ComfyExportWidthBox" Value="1024"
                                                       AutomationProperties.AutomationId="ComfyExportWidthBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Height" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="ComfyExportHeightBox" Value="576"
                                                       AutomationProperties.AutomationId="ComfyExportHeightBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Steps" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="ComfyExportStepsBox" Value="28"
                                                       AutomationProperties.AutomationId="ComfyExportStepsBox" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="ComfyExportAdvancedBox"
                                             Header="Optional advanced query JSON (loras, outpaint, controlnet_units, hires_fix, refiner, upscaler)"
                                             Text="{}{}"
                                             AcceptsReturn="True"
                                             MinHeight="120"
                                             FontFamily="Consolas"
                                             TextWrapping="Wrap"
                                             AutomationProperties.AutomationId="ComfyExportAdvancedBox" />
                                    <Button Content="Export ComfyUI workflows"
                                            HorizontalAlignment="Left"
                                            Click="ExportComfyUi_Click"
                                            AutomationProperties.AutomationId="ExportComfyUiButton" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Project assets"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="AssetsExpander">
                                <StackPanel Padding="12" Spacing="12">
                                    <TextBlock Text="Choose a local file to upload it into the active project. The returned project-relative path is copied into the matching field below."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Content="Upload reference" Click="UploadReference_Click"
                                                AutomationProperties.AutomationId="UploadReferenceButton" />
                                        <TextBox x:Name="UploadedReferenceBox"
                                                 Grid.Column="1"
                                                 IsReadOnly="True"
                                                 PlaceholderText="No reference uploaded"
                                                 AutomationProperties.AutomationId="UploadedReferenceBox" />
                                        <Button Grid.Row="1" Content="Upload mask" Click="UploadMask_Click"
                                                AutomationProperties.AutomationId="UploadMaskButton" />
                                        <TextBox x:Name="UploadedMaskBox"
                                                 Grid.Row="1"
                                                 Grid.Column="1"
                                                 IsReadOnly="True"
                                                 PlaceholderText="No mask uploaded"
                                                 AutomationProperties.AutomationId="UploadedMaskBox" />
                                        <Button Grid.Row="2" Content="Upload overlay" Click="UploadOverlay_Click"
                                                AutomationProperties.AutomationId="UploadOverlayButton" />
                                        <TextBox x:Name="UploadedOverlayBox"
                                                 Grid.Row="2"
                                                 Grid.Column="1"
                                                 IsReadOnly="True"
                                                 PlaceholderText="No overlay uploaded"
                                                 AutomationProperties.AutomationId="UploadedOverlayBox" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Operations"
                             IsClosable="False"
                             AutomationProperties.AutomationId="RenderOperationsTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="4,12,12,12" Spacing="12">
                            <Expander Header="Worker"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="WorkerExpander">
                                <StackPanel Padding="12" Spacing="12">
                                    <TextBlock Text="Run one manual worker tick to claim and execute the next queued job."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Content="Run worker tick"
                                            HorizontalAlignment="Left"
                                            Click="WorkerTick_Click"
                                            AutomationProperties.AutomationId="WorkerTickButton" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="EDMG runtime"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="EdmgRuntimeExpander">
                                <StackPanel Padding="12" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Get EDMG status" Click="GetEdmgStatus_Click"
                                                AutomationProperties.AutomationId="GetEdmgStatusButton" />
                                        <Button Content="Verify EDMG" Click="VerifyEdmg_Click"
                                                AutomationProperties.AutomationId="VerifyEdmgButton" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Project jobs"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="ProjectJobsExpander">
                                <StackPanel Padding="12" Spacing="12">
                                    <Button Content="Refresh project jobs"
                                            HorizontalAlignment="Left"
                                            Click="RefreshJobs_Click"
                                            AutomationProperties.AutomationId="RefreshRenderJobsButton" />
                                    <TextBox x:Name="JobFeedbackBox"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             MinHeight="240"
                                             FontFamily="Consolas"
                                             TextWrapping="Wrap"
                                             AutomationProperties.AutomationId="RenderJobFeedbackBox" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>

            <Border Grid.Column="1"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <Border Padding="12"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            AutomationProperties.AutomationId="RenderRuntimeCapabilitiesCard">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="Compute readiness"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ProgressRing x:Name="RuntimeCapabilityProgressRing"
                                              Grid.Column="1"
                                              Width="18"
                                              Height="18"
                                              IsActive="False"
                                              Visibility="Collapsed" />
                                <Button Grid.Column="2"
                                        Content="Refresh"
                                        Click="RefreshRuntimeCapabilities_Click"
                                        AutomationProperties.AutomationId="RefreshRenderRuntimeCapabilitiesButton" />
                            </Grid>
                            <TextBlock x:Name="RuntimeAcceleratorText"
                                       Text="Backend hardware has not been checked."
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="RenderRuntimeAcceleratorText" />
                            <TextBlock x:Name="RuntimeCudaText"
                                       Text="CUDA status is waiting for the backend."
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="RuntimeTensorCoreText"
                                       Text="RTX Tensor Core status is waiting for the backend."
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="RuntimeTensorRtText"
                                       Text="TensorRT status is waiting for Models."
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="RuntimeTritonText"
                                       Text="Triton is backend-managed and has no independent render switch."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="The latest backend response or actionable error."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="GlobalResultBox"
                             Grid.Row="2"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="RenderGlobalDiagnosticsBox" />
                    <Grid Grid.Row="3">
                        <TextBlock Text="Activity log" FontWeight="SemiBold" />
                        <Button Content="Clear"
                                HorizontalAlignment="Right"
                                Click="ClearLog_Click"
                                AutomationProperties.AutomationId="ClearRenderLogButton" />
                    </Grid>
                    <TextBox x:Name="ActionLogBox"
                             Grid.Row="4"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="RenderActionLogBox" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="BusyRing"
                          Width="24"
                          Height="24"
                          IsActive="False"
                          AutomationProperties.AutomationId="RenderBusyRing" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="BusyText"
                           Text="Ready"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="BusyProgressBar"
                             IsIndeterminate="False"
                             Value="0"
                             AutomationProperties.AutomationId="RenderBusyProgressBar" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
