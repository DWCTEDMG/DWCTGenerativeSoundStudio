<Page
    x:Class="EdmgStudio.WinUI.Pages.RenderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="WorkflowExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Render Studio" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Native controls for planning, generation, assembly, export, and worker operations."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                <TextBlock Text="Active project" HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ActiveProjectText"
                           Text="No project selected"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="360" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Informational"
                 AutomationProperties.AutomationId="RenderStatusInfoBar" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <TabView x:Name="WorkflowTabView"
                     TabWidthMode="SizeToContent"
                     AutomationProperties.AutomationId="RenderWorkflowTabs">
                <TabViewItem Header="Internal"
                             IsClosable="False"
                             AutomationProperties.AutomationId="RenderInternalTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="4,12,12,12" Spacing="12">
                            <Expander Header="Generation"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="InternalGenerationExpander">
                                <StackPanel Padding="12" Spacing="12">
                                    <TextBlock Text="Prompt" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="PromptBox"
                                             AcceptsReturn="True"
                                             MinHeight="100"
                                             TextWrapping="Wrap"
                                             PlaceholderText="Describe the visual sequence"
                                             AutomationProperties.AutomationId="RenderPromptBox" />
                                    <TextBlock Text="Negative prompt" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="NegativePromptBox"
                                             AcceptsReturn="True"
                                             MinHeight="72"
                                             TextWrapping="Wrap"
                                             Text="blurry, low quality, watermark, text, logo"
                                             AutomationProperties.AutomationId="RenderNegativePromptBox" />

                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Mode" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="ModeComboBox"
                                                      SelectedIndex="0"
                                                      AutomationProperties.AutomationId="RenderModeComboBox">
                                                <ComboBoxItem Content="internal" />
                                                <ComboBoxItem Content="preview" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Device" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="DeviceComboBox"
                                                      SelectedIndex="0"
                                                      AutomationProperties.AutomationId="RenderDeviceComboBox">
                                                <ComboBoxItem Content="auto" />
                                                <ComboBoxItem Content="cuda" />
                                                <ComboBoxItem Content="cpu" />
                                                <ComboBoxItem Content="mps" />
                                                <ComboBoxItem Content="directml" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Quality tier" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="TierComboBox"
                                                      SelectedIndex="1"
                                                      AutomationProperties.AutomationId="RenderTierComboBox">
                                                <ComboBoxItem Content="draft" />
                                                <ComboBoxItem Content="balanced" />
                                                <ComboBoxItem Content="quality" />
                                                <ComboBoxItem Content="ultra" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock Text="Width" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="WidthBox" Value="768" Minimum="256" Maximum="1920"
                                                       AutomationProperties.AutomationId="RenderWidthBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Height" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="HeightBox" Value="432" Minimum="256" Maximum="1080"
                                                       AutomationProperties.AutomationId="RenderHeightBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                            <TextBlock Text="FPS" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="FpsBox" Value="24" Minimum="1" Maximum="60"
                                                       AutomationProperties.AutomationId="RenderFpsBox" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Diffusion and models"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="InternalDiffusionExpander">
                                <Grid Padding="12" ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Steps" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="StepsBox" Value="24" Minimum="1" Maximum="80"
                                                   AutomationProperties.AutomationId="RenderStepsBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="CFG" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="CfgBox" Value="7" Minimum="1" Maximum="20" SmallChange="0.1"
                                                   AutomationProperties.AutomationId="RenderCfgBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Seed (blank = automatic)" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="SeedBox"
                                                   Minimum="0"
                                                   Maximum="4294967295"
                                                   AutomationProperties.AutomationId="RenderSeedBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Sampler" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="SamplerComboBox"
                                                  IsEditable="True"
                                                  Text="euler"
                                                  AutomationProperties.AutomationId="RenderSamplerComboBox">
                                            <ComboBoxItem Content="euler" />
                                            <ComboBoxItem Content="euler_a" />
                                            <ComboBoxItem Content="dpmpp_2m" />
                                            <ComboBoxItem Content="ddim" />
                                            <ComboBoxItem Content="pndm" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="4">
                                        <TextBlock Text="Model ID" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="ModelBox" PlaceholderText="Optional model identifier"
                                                 AutomationProperties.AutomationId="RenderModelBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="VAE" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="VaeBox" PlaceholderText="Optional VAE"
                                                 AutomationProperties.AutomationId="RenderVaeBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="LoRAs (name:weight, comma separated)" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="LorasBox" PlaceholderText="detail.safetensors:0.7, style.safetensors:1.0"
                                                 AutomationProperties.AutomationId="RenderLorasBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Spacing="4">
                                        <TextBlock Text="Refiner model" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="RefinerModelBox" PlaceholderText="Optional"
                                                 AutomationProperties.AutomationId="RenderRefinerModelBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Refiner switch" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="RefinerSwitchBox" Value="0.8" Minimum="0" Maximum="1" SmallChange="0.05"
                                                   AutomationProperties.AutomationId="RenderRefinerSwitchBox" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="EnableRefinerToggle"
                                                  Grid.Row="5"
                                                  Header="Enable refiner"
                                                  AutomationProperties.AutomationId="RenderEnableRefinerToggle" />
                                    <ToggleSwitch x:Name="FaceRestoreToggle"
                                                  Grid.Row="5"
                                                  Grid.Column="1"
                                                  Header="Face restoration"
                                                  AutomationProperties.AutomationId="RenderFaceRestoreToggle" />
                                </Grid>
                            </Expander>

                            <Expander Header="Temporal and motion controls"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="InternalMotionExpander">
                                <Grid Padding="12" ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Duration (seconds)" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="DurationBox" Value="5" Minimum="0.5" Maximum="120" SmallChange="0.5"
                                                   AutomationProperties.AutomationId="RenderDurationBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Frames" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="FramesBox" Value="120" Minimum="1" Maximum="4000"
                                                   AutomationProperties.AutomationId="RenderFramesBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Motion strength" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="MotionStrengthBox" Value="1" Minimum="0" Maximum="4" SmallChange="0.1"
                                                   AutomationProperties.AutomationId="RenderMotionStrengthBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Temporal consistency" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="TemporalConsistencyBox" Value="0.75" Minimum="0" Maximum="1" SmallChange="0.05"
                                                   AutomationProperties.AutomationId="RenderTemporalConsistencyBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="4">
                                        <TextBlock Text="Motion source" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="MotionSourceBox" PlaceholderText="Optional motion asset"
                                                 AutomationProperties.AutomationId="RenderMotionSourceBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Interpolation" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="InterpolationComboBox"
                                                  SelectedIndex="0"
                                                  AutomationProperties.AutomationId="RenderInterpolationComboBox">
                                            <ComboBoxItem Content="none" />
                                            <ComboBoxItem Content="rife" />
                                            <ComboBoxItem Content="film" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="Parseq manifest (optional JSON)" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="ParseqBox"
                                                 AcceptsReturn="True"
                                                 MinHeight="110"
                                                 TextWrapping="Wrap"
                                                 PlaceholderText="JSON object"
                                                 AutomationProperties.AutomationId="RenderParseqBox" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LoopToggle"
                                                  Grid.Row="4"
                                                  Header="Loop output"
                                                  AutomationProperties.AutomationId="RenderLoopToggle" />
                                    <ToggleSwitch x:Name="IncludeAudioToggle"
                                                  Grid.Row="4"
                                                  Grid.Column="1"
                                                  Header="Include audio"
                                                  AutomationProperties.AutomationId="RenderIncludeAudioToggle" />
                                </Grid>
                            </Expander>

                            <Expander Header="Hosted provider"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="InternalHostedExpander">
                                <Grid Padding="12" ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Provider" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="HostedProviderComboBox"
                                                  SelectedIndex="0"
                                                  AutomationProperties.AutomationId="RenderHostedProviderComboBox">
                                            <ComboBoxItem Content="auto" />
                                            <ComboBoxItem Content="replicate" />
                                            <ComboBoxItem Content="fal" />
                                            <ComboBoxItem Content="runway" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Hosted model" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="HostedModelBox" PlaceholderText="Optional hosted model"
                                                 AutomationProperties.AutomationId="RenderHostedModelBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="Provider options (JSON)" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="HostedOptionsBox"
                                                 AcceptsReturn="True"
                                                 MinHeight="90"
                                                 TextWrapping="Wrap"
                                                 PlaceholderText="JSON object"
                                                 AutomationProperties.AutomationId="RenderHostedOptionsBox" />
                                    </StackPanel>
                                </Grid>
                            </Expander>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PreflightButton"
                                        Content="Run preflight"
                                        Click="Preflight_Click"
                                        AutomationProperties.AutomationId="RenderPreflightButton" />
                                <Button x:Name="RenderButton"
                                        Content="Start internal render"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="Render_Click"
                                        AutomationProperties.AutomationId="RenderStartButton" />
                            </StackPanel>
                            <TextBox x:Name="PreflightResultBox"
                                     Header="Internal preflight and render response"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     MinHeight="160"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     AutomationProperties.AutomationId="RenderPreflightResultBox" />
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Pipeline &amp; Plans"
                             IsClosable="False"
                             AutomationProperties.AutomationId="RenderPipelinePlansTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="4,12,12,12" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Variant index" Style="{StaticResource FieldLabelStyle}" />
                                    <NumberBox x:Name="WorkflowVariantBox" Value="0" Minimum="0"
                                               AutomationProperties.AutomationId="WorkflowVariantBox" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="This variant is shared by pipeline, conductor, performer, and motion-sequencer actions."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Expander Header="Pipeline"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="PipelineExpander">
                                <StackPanel Padding="12" Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Preset" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="PipelinePresetComboBox" SelectedIndex="1"
                                                      AutomationProperties.AutomationId="PipelinePresetComboBox">
                                                <ComboBoxItem Content="fast" />
                                                <ComboBoxItem Content="balanced" />
                                                <ComboBoxItem Content="quality" />
                                                <ComboBoxItem Content="ultra" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Mode" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="PipelineModeComboBox" SelectedIndex="0"
                                                      AutomationProperties.AutomationId="PipelineModeComboBox">
                                                <ComboBoxItem Content="auto" />
                                                <ComboBoxItem Content="internal" />
                                                <ComboBoxItem Content="stills" />
                                                <ComboBoxItem Content="motion" />
                                                <ComboBoxItem Content="smart_video" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Engine" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="PipelineEngineComboBox" SelectedIndex="0"
                                                      AutomationProperties.AutomationId="PipelineEngineComboBox">
                                                <ComboBoxItem Content="auto" />
                                                <ComboBoxItem Content="internal" />
                                                <ComboBoxItem Content="comfyui" />
                                                <ComboBoxItem Content="hosted" />
                                                <ComboBoxItem Content="tensorrt_standalone" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Validate pipeline" Click="ValidatePipeline_Click"
                                                AutomationProperties.AutomationId="ValidatePipelineButton" />
                                        <Button Content="Run pipeline" Click="RunPipeline_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                AutomationProperties.AutomationId="RunPipelineButton" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Render conductor"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="ConductorExpander">
                                <StackPanel Padding="12" Spacing="12">
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Preset" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="ConductorPresetComboBox" SelectedIndex="1"
                                                      AutomationProperties.AutomationId="ConductorPresetComboBox">
                                                <ComboBoxItem Content="fast" />
                                                <ComboBoxItem Content="balanced" />
                                                <ComboBoxItem Content="quality" />
                                                <ComboBoxItem Content="ultra" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Aspect ratio" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="ConductorAspectComboBox" SelectedIndex="0"
                                                      AutomationProperties.AutomationId="ConductorAspectComboBox">
                                                <ComboBoxItem Content="16:9" />
                                                <ComboBoxItem Content="9:16" />
                                                <ComboBoxItem Content="1:1" />
                                                <ComboBoxItem Content="21:9" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Output mode" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="ConductorOutputModeComboBox" SelectedIndex="0"
                                                      AutomationProperties.AutomationId="ConductorOutputModeComboBox">
                                                <ComboBoxItem Content="full_video" />
                                                <ComboBoxItem Content="scene_batch" />
                                                <ComboBoxItem Content="preview" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock Text="Quality tier" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="ConductorQualityComboBox" SelectedIndex="1"
                                                      AutomationProperties.AutomationId="ConductorQualityComboBox">
                                                <ComboBoxItem Content="draft" />
                                                <ComboBoxItem Content="balanced" />
                                                <ComboBoxItem Content="quality" />
                                                <ComboBoxItem Content="ultra" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Continuity priority" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="ConductorContinuityBox" Value="0.7" Minimum="0" Maximum="1" SmallChange="0.05"
                                                       AutomationProperties.AutomationId="ConductorContinuityBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Speed priority" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="ConductorSpeedBox" Value="0.5" Minimum="0" Maximum="1" SmallChange="0.05"
                                                       AutomationProperties.AutomationId="ConductorSpeedBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="4">
                                            <TextBlock Text="Style lock" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="ConductorStyleLockBox" Value="0.75" Minimum="0" Maximum="1" SmallChange="0.05"
                                                       AutomationProperties.AutomationId="ConductorStyleLockBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Fallback policy" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="ConductorFallbackComboBox" SelectedIndex="0"
                                                      AutomationProperties.AutomationId="ConductorFallbackComboBox">
                                                <ComboBoxItem Content="auto" />
                                                <ComboBoxItem Content="strict" />
                                                <ComboBoxItem Content="manual" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Plan ID" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="ConductorPlanIdBox" PlaceholderText="Optional plan ID"
                                                     AutomationProperties.AutomationId="ConductorPlanIdBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Spacing="4">
                                            <TextBlock Text="Allowed engines (comma separated)" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="ConductorAllowedEnginesBox"
                                                     Text="internal, comfyui_still, comfyui_motion, hosted_video, deforum_export, tensorrt_standalone"
                                                     AutomationProperties.AutomationId="ConductorAllowedEnginesBox" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Inspect plan" Click="InspectConductorPlan_Click"
                                                AutomationProperties.AutomationId="InspectConductorPlanButton" />
                                        <Button Content="Create plan" Click="CreateConductorPlan_Click"
                                                AutomationProperties.AutomationId="CreateConductorPlanButton" />
                                        <Button Content="Inspect continuity" Click="InspectConductorContinuity_Click"
                                                AutomationProperties.AutomationId="InspectConductorContinuityButton" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Promote scene IDs (comma separated)" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="ConductorSceneIdsBox" AutomationProperties.AutomationId="ConductorSceneIdsBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
