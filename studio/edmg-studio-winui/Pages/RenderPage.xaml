<Page
    x:Class="EdmgStudio.WinUI.Pages.RenderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="32,24,32,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Render" />
                <TextBlock Foreground="{ThemeResource SecondaryTextBrush}"
                           Text="Submit validated internal renders to the CUDA-capable backend." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Padding="10,5" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="12">
                    <TextBlock x:Name="ProjectText" Text="No active project" />
                </Border>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" Margin="32,0,32,12"
                 IsClosable="True" IsOpen="False" Severity="Informational" />

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,0,32,24" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="480" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="16">
                    <Border Padding="20" Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="16">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Generation" />
                            <TextBox x:Name="PromptBox" AutomationProperties.AutomationId="Render.Prompt"
                                     Header="Opening prompt override" AcceptsReturn="True" TextWrapping="Wrap"
                                     PlaceholderText="Optional frame-zero prompt; timeline scenes remain authoritative." />
                            <TextBox x:Name="NegativePromptBox" AutomationProperties.AutomationId="Render.NegativePrompt"
                                     Header="Negative prompt" PlaceholderText="Artifacts, unwanted styles, or content to avoid" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="ModeBox" AutomationProperties.AutomationId="Render.Mode"
                                          Header="Mode" SelectedIndex="0">
                                    <x:String>auto</x:String>
                                    <x:String>diffusion</x:String>
                                    <x:String>tensorrt</x:String>
                                    <x:String>hosted</x:String>
                                </ComboBox>
                                <ComboBox x:Name="DeviceBox" Grid.Column="1" AutomationProperties.AutomationId="Render.Device"
                                          Header="Device" SelectedIndex="0">
                                    <x:String>auto</x:String>
                                    <x:String>cuda</x:String>
                                    <x:String>cpu</x:String>
                                </ComboBox>
                                <ComboBox x:Name="TierBox" Grid.Column="2" AutomationProperties.AutomationId="Render.Tier"
                                          Header="Quality tier" SelectedIndex="2">
                                    <x:String>auto</x:String>
                                    <x:String>draft</x:String>
                                    <x:String>balanced</x:String>
                                    <x:String>quality</x:String>
                                </ComboBox>
                                <NumberBox x:Name="WidthBox" Grid.Row="1" AutomationProperties.AutomationId="Render.Width"
                                           Header="Width" Minimum="256" Maximum="1920" SmallChange="64"
                                           SpinButtonPlacementMode="Compact" Value="1280" />
                                <NumberBox x:Name="HeightBox" Grid.Row="1" Grid.Column="1"
                                           AutomationProperties.AutomationId="Render.Height"
                                           Header="Height" Minimum="256" Maximum="1080" SmallChange="64"
                                           SpinButtonPlacementMode="Compact" Value="720" />
                                <NumberBox x:Name="FpsBox" Grid.Row="1" Grid.Column="2"
                                           AutomationProperties.AutomationId="Render.Fps"
                                           Header="Output FPS" Minimum="1" Maximum="60" SmallChange="1"
                                           SpinButtonPlacementMode="Compact" Value="24" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="20" Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="16">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Diffusion controls" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="StepsBox" AutomationProperties.AutomationId="Render.Steps"
                                           Header="Steps" Minimum="1" Maximum="80"
                                           SpinButtonPlacementMode="Compact" Value="28" />
                                <NumberBox x:Name="CfgBox" Grid.Column="1" AutomationProperties.AutomationId="Render.Cfg"
                                           Header="CFG scale" Minimum="1" Maximum="20" SmallChange="0.5"
                                           SpinButtonPlacementMode="Compact" Value="7" />
                                <NumberBox x:Name="SeedBox" Grid.Column="2" AutomationProperties.AutomationId="Render.Seed"
                                           Header="Seed" Minimum="-1" Maximum="2147483647"
                                           SpinButtonPlacementMode="Compact" Value="-1" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SamplerBox" AutomationProperties.AutomationId="Render.Sampler"
                                          Header="Sampler" SelectedIndex="0">
                                    <x:String>euler</x:String>
                                    <x:String>euler_a</x:String>
                                    <x:String>dpmpp_2m</x:String>
                                    <x:String>dpmpp_sde</x:String>
                                    <x:String>ddim</x:String>
                                </ComboBox>
                                <TextBox x:Name="ModelBox" Grid.Column="1" AutomationProperties.AutomationId="Render.Model"
                                         Header="Model override" PlaceholderText="Use routing/default model" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Expander Header="Advanced render options" IsExpanded="False">
                        <Border Margin="0,8,0,0" Padding="20" Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LoraBox" AutomationProperties.AutomationId="Render.Lora"
                                             Header="LoRAs" PlaceholderText="name@weight, another@0.7" />
                                    <TextBox x:Name="VaeBox" Grid.Column="1" AutomationProperties.AutomationId="Render.Vae"
                                             Header="VAE" PlaceholderText="Optional VAE override" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RefinerBox" AutomationProperties.AutomationId="Render.Refiner"
                                             Header="Refiner model" />
                                    <TextBox x:Name="InterpolationBox" Grid.Column="1"
                                             AutomationProperties.AutomationId="Render.Interpolation"
                                             Header="Interpolation" PlaceholderText="auto, minterpolate, fps, rife" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="KeyframeBox" AutomationProperties.AutomationId="Render.KeyframeInterval"
                                               Header="Keyframe interval (s)" Minimum="0.5" Maximum="60" SmallChange="0.5"
                                               SpinButtonPlacementMode="Compact" Value="5" />
                                    <NumberBox x:Name="TemporalBox" Grid.Column="1"
                                               AutomationProperties.AutomationId="Render.Temporal"
                                               Header="Temporal strength" Minimum="0.01" Maximum="0.99" SmallChange="0.05"
                                               SpinButtonPlacementMode="Compact" Value="0.35" />
                                    <NumberBox x:Name="MotionBox" Grid.Column="2"
                                               AutomationProperties.AutomationId="Render.Motion"
                                               Header="Motion strategy bias" Minimum="0.25" Maximum="4.75" SmallChange="0.25"
                                               SpinButtonPlacementMode="Compact" Value="1" />
                                </Grid>
                                <TextBox x:Name="DeforumBox" AutomationProperties.AutomationId="Render.Deforum"
                                         Header="Parseq manifest JSON" AcceptsReturn="True"
                                         FontFamily="Consolas" Height="110" TextWrapping="NoWrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AudioAssetBox" AutomationProperties.AutomationId="Render.AudioAsset"
                                             Header="Project audio" IsReadOnly="True"
                                             Text="Uses active project timeline audio" />
                                    <TextBox x:Name="VideoAssetBox" Grid.Column="1"
                                             AutomationProperties.AutomationId="Render.VideoAsset"
                                             Header="Source asset path" PlaceholderText="assets/refs/example.png" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Padding="20" Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="14">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Hosted provider" />
                            <ToggleSwitch x:Name="HostedBox" AutomationProperties.AutomationId="Render.UseHosted"
                                          Header="Use hosted generation" />
                            <ComboBox x:Name="ProviderBox" AutomationProperties.AutomationId="Render.Provider"
                                      Header="Hosted service" SelectedIndex="0">
                                <x:String>default</x:String>
                                <x:String>core</x:String>
                                <x:String>ultra</x:String>
                                <x:String>sd3</x:String>
                            </ComboBox>
                            <TextBox x:Name="HostedModelBox" AutomationProperties.AutomationId="Render.HostedModel"
                                     Header="Hosted model" PlaceholderText="Use provider default" />
                            <ToggleSwitch x:Name="HostedFallbackBox"
                                          AutomationProperties.AutomationId="Render.HostedFallback"
                                          Header="Allow hosted fallback" IsOn="True" />
                            <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Credentials remain in the backend secret store. Configure Foundry and routing under Settings." />
                        </StackPanel>
                    </Border>

                    <Border Padding="20" Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Preflight" />
                            <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="The backend checks project assets, capabilities, model/provider availability, and render settings." />
                            <Button x:Name="PreflightButton" AutomationProperties.AutomationId="Render.Preflight"
                                    Click="PreflightButton_Click" Content="Run preflight" />
                            <TextBox x:Name="PreflightResultBox" Height="250" IsReadOnly="True"
                                     AutomationProperties.AutomationId="Render.PreflightResult"
                                     FontFamily="Consolas" TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="20,12" Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                    <TextBlock Foreground="{ThemeResource SecondaryTextBrush}"
                               Text="Final renders always use the internal backend pipeline; proxy rendering is not available." />
                </StackPanel>
                <Button x:Name="RenderButton" HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="Render.Start"
                        Click="RenderButton_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="Start render" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
