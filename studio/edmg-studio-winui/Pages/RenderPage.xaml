<Page
    x:Class="EdmgStudio.WinUI.Pages.RenderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="WorkflowExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Render Studio" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Native controls for planning, generation, assembly, export, and worker operations."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                <TextBlock Text="Active project" HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ActiveProjectText"
                           Text="No project selected"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="360" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Informational"
                 AutomationProperties.AutomationId="RenderStatusInfoBar" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <TabView x:Name="WorkflowTabView"
                     TabWidthMode="SizeToContent"
                     AutomationProperties.AutomationId="RenderWorkflowTabs">
                <TabViewItem Header="Internal"
                             IsClosable="False"
                             AutomationProperties.AutomationId="RenderInternalTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="4,12,12,12" Spacing="12">
                            <Border Padding="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    AutomationProperties.AutomationId="RenderQuickSetupCard">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Render control center" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="Choose the result you want, apply a complete starting setup, then refine any setting in the detailed controls below. Studio uses real downloaded or configured models; synthetic proxy substitution is disabled."
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Goal" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="QuickGoalComboBox" SelectedIndex="0"
                                                      AutomationProperties.AutomationId="RenderQuickGoalComboBox">
                                                <ComboBoxItem Content="Automatic internal" Tag="auto" />
                                                <ComboBoxItem Content="Still scenes" Tag="stills" />
                                                <ComboBoxItem Content="AnimateDiff motion" Tag="motion_ad" />
                                                <ComboBoxItem Content="SVD image to video" Tag="motion_svd" />
                                                <ComboBoxItem Content="Full-motion video" Tag="full_video" />
                                                <ComboBoxItem Content="Edit existing video" Tag="edit" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Quality" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="QuickQualityComboBox" SelectedIndex="1"
                                                      AutomationProperties.AutomationId="RenderQuickQualityComboBox">
                                                <ComboBoxItem Content="Fast" Tag="fast" />
                                                <ComboBoxItem Content="Balanced" Tag="balanced" />
                                                <ComboBoxItem Content="Quality" Tag="quality" />
                                                <ComboBoxItem Content="Ultra" Tag="ultra" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Resolution" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="QuickResolutionComboBox" SelectedIndex="0"
                                                      AutomationProperties.AutomationId="RenderQuickResolutionComboBox">
                                                <ComboBoxItem Content="768 × 432 — preview" Tag="768x432" />
                                                <ComboBoxItem Content="1024 × 576 — 16:9" Tag="1024x576" />
                                                <ComboBoxItem Content="1280 × 720 — HD" Tag="1280x720" />
                                                <ComboBoxItem Content="1920 × 1080 — Full HD" Tag="1920x1080" />
                                                <ComboBoxItem Content="1024 × 1024 — square" Tag="1024x1024" />
                                                <ComboBoxItem Content="864 × 1080 — portrait" Tag="864x1080" />
                                                <ComboBoxItem Content="576 × 1024 — vertical" Tag="576x1024" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock Text="Output FPS" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="QuickFpsBox" Value="24" Minimum="1" Maximum="60"
                                                       AutomationProperties.AutomationId="RenderQuickFpsBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                                            <TextBlock Text="Model" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="QuickModelBox"
                                                     Text="auto"
                                                     PlaceholderText="auto or a downloaded model ID"
                                                     AutomationProperties.AutomationId="RenderQuickModelBox" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Plan shots with AI"
                                                Click="OpenAiPlanner_Click"
                                                AutomationProperties.AutomationId="OpenRenderAiPlannerButton"
                                                ToolTipService.ToolTip="Open the AI Planner to build editable shot timing and prompts for this project." />
                                        <Button Content="Apply setup"
                                                Click="ApplyQuickSetup_Click"
                                                AutomationProperties.AutomationId="ApplyRenderQuickSetupButton" />
                                        <Button Content="Preflight"
                                                Click="QuickPreflight_Click"
                                                AutomationProperties.AutomationId="PreflightRenderQuickSetupButton" />
                                        <Button Content="Render / open Timeline"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="QuickRender_Click"
                                                AutomationProperties.AutomationId="RunRenderQuickSetupButton" />
                                    </StackPanel>
                                    <TextBlock x:Name="QuickSetupSummaryText"
                                               Text="Automatic internal · balanced · 768 × 432 · 24 FPS"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="RenderQuickSetupSummary" />
                                </StackPanel>
                            </Border>

                            <Border Padding="16"
                                   CornerRadius="8"
                                   Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                   BorderThickness="1"
                                   AutomationProperties.AutomationId="RenderModelGuidanceCard">
                               <StackPanel Spacing="10">
                                   <StackPanel Orientation="Horizontal" Spacing="8">
                                       <TextBlock Text="Model readiness"
                                                  Style="{StaticResource SectionHeaderStyle}"
                                                  VerticalAlignment="Center" />
                                       <ProgressRing x:Name="ModelGuidanceProgressRing"
                                                     Width="18"
                                                     Height="18"
                                                     IsActive="False"
                                                     Visibility="Collapsed" />
                                   </StackPanel>
                                   <TextBlock x:Name="ModelGuidanceSummaryText"
                                              Text="Loading the model catalogue. Manual render controls remain available."
                                              TextWrapping="Wrap"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              AutomationProperties.AutomationId="RenderModelGuidanceSummary" />
                                   <TextBlock x:Name="PrimaryModelGuidanceText"
                                              Text="Primary model: not evaluated"
                                              TextWrapping="Wrap" />
                                   <TextBlock x:Name="VideoModelGuidanceText"
                                              Text="Video model: not required"
                                              TextWrapping="Wrap" />
                                   <TextBlock x:Name="ModelGuidanceBlockersText"
                                              TextWrapping="Wrap"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                              Visibility="Collapsed"
                                              AutomationProperties.AutomationId="RenderModelGuidanceBlockers" />
                                   <StackPanel Orientation="Horizontal" Spacing="8">
                                       <Button x:Name="ApplyRecommendedPrimaryModelButton"
                                               Content="Use recommended primary"
                                               Click="ApplyRecommendedPrimaryModel_Click"
                                               IsEnabled="False"
                                               AutomationProperties.AutomationId="ApplyRecommendedPrimaryModelButton" />
                                       <Button x:Name="ApplyRecommendedVideoModelButton"
                                               Content="Use recommended video model"
                                               Click="ApplyRecommendedVideoModel_Click"
                                               IsEnabled="False"
                                               AutomationProperties.AutomationId="ApplyRecommendedVideoModelButton" />
                                       <Button Content="Refresh guidance"
                                               Click="RefreshModelGuidance_Click"
                                               AutomationProperties.AutomationId="RefreshRenderModelGuidanceButton" />
                                       <Button Content="Open Models"
                                               Click="OpenModels_Click"
                                               AutomationProperties.AutomationId="OpenModelsFromRenderButton" />
                                   </StackPanel>
                               </StackPanel>
                            </Border>

                            <Expander Header="Generation"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="InternalGenerationExpander">
                                <StackPanel Padding="12" Spacing="12">
                                    <TextBlock Text="Prompt" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="PromptBox"
                                             AcceptsReturn="True"
                                             MinHeight="100"
                                             TextWrapping="Wrap"
                                             PlaceholderText="Describe the visual sequence"
                                             AutomationProperties.AutomationId="RenderPromptBox" />
                                    <TextBlock Text="Negative prompt" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="NegativePromptBox"
                                             AcceptsReturn="True"
                                             MinHeight="72"
                                             TextWrapping="Wrap"
                                             Text="blurry, low quality, watermark, text, logo"
                                             AutomationProperties.AutomationId="RenderNegativePromptBox" />

                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Mode" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="ModeComboBox"
                                                      SelectedIndex="0"
                                                      SelectionChanged="ModelGuidanceSelection_Changed"
                                                      AutomationProperties.AutomationId="RenderModeComboBox">
                                                <ComboBoxItem Content="Automatic" Tag="auto" />
                                                <ComboBoxItem Content="Internal diffusion" Tag="diffusion" />
                                                <ComboBoxItem Content="Hosted keyframes" Tag="hosted" />
                                                <ComboBoxItem Content="TensorRT" Tag="tensorrt" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Device" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="DeviceComboBox"
                                                      SelectedIndex="0"
                                                      SelectionChanged="ModelGuidanceSelection_Changed"
                                                      AutomationProperties.AutomationId="RenderDeviceComboBox">
                                                <ComboBoxItem Content="auto" />
                                                <ComboBoxItem Content="cuda" />
                                                <ComboBoxItem Content="cpu" />
                                                <ComboBoxItem Content="mps" />
                                                <ComboBoxItem Content="directml" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Quality tier" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="TierComboBox"
                                                      SelectedIndex="2"
                                                      AutomationProperties.AutomationId="RenderTierComboBox">
                                                <ComboBoxItem Content="Automatic" Tag="auto" />
                                                <ComboBoxItem Content="Draft" Tag="draft" />
                                                <ComboBoxItem Content="Balanced" Tag="balanced" />
                                                <ComboBoxItem Content="Quality" Tag="quality" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock Text="Width" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="WidthBox" Value="768" Minimum="256" Maximum="1920"
                                                       AutomationProperties.AutomationId="RenderWidthBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Height" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="HeightBox" Value="432" Minimum="256" Maximum="1080"
                                                       AutomationProperties.AutomationId="RenderHeightBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                            <TextBlock Text="FPS" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="FpsBox" Value="24" Minimum="1" Maximum="60"
                                                       AutomationProperties.AutomationId="RenderFpsBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="4">
                                            <TextBlock Text="Generation FPS" Style="{StaticResource FieldLabelStyle}" />
                                            <NumberBox x:Name="RenderFpsBox" Value="3" Minimum="1" Maximum="30"
                                                       AutomationProperties.AutomationId="RenderGenerationFpsBox" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Diffusion and models"
                                      IsExpanded="True"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="InternalDiffusionExpander">
                                <Grid Padding="12" ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Steps" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="StepsBox" Value="24" Minimum="1" Maximum="80"
                                                   AutomationProperties.AutomationId="RenderStepsBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="CFG" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="CfgBox" Value="7" Minimum="1" Maximum="20" SmallChange="0.1"
                                                   AutomationProperties.AutomationId="RenderCfgBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Seed (blank = automatic)" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="SeedBox"
                                                   Minimum="0"
                                                   Maximum="4294967295"
                                                   AutomationProperties.AutomationId="RenderSeedBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Sampler" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="SamplerComboBox"
                                                  IsEditable="True"
                                                  Text="euler"
                                                  AutomationProperties.AutomationId="RenderSamplerComboBox">
                                            <ComboBoxItem Content="euler" />
                                            <ComboBoxItem Content="euler_a" />
                                            <ComboBoxItem Content="dpmpp_2m" />
                                            <ComboBoxItem Content="ddim" />
                                            <ComboBoxItem Content="pndm" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="4">
                                        <TextBlock Text="Model ID" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="ModelBox" PlaceholderText="Optional model identifier"
                                                 TextChanged="ModelGuidanceText_Changed"
                                                 AutomationProperties.AutomationId="RenderModelBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="VAE" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="VaeBox" PlaceholderText="Optional VAE"
                                                 AutomationProperties.AutomationId="RenderVaeBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="LoRAs (name:weight, comma separated)" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="LorasBox" PlaceholderText="detail.safetensors:0.7, style.safetensors:1.0"
                                                 AutomationProperties.AutomationId="RenderLorasBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Spacing="4">
                                        <TextBlock Text="Refiner model" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="RefinerModelBox" PlaceholderText="Optional"
                                                 AutomationProperties.AutomationId="RenderRefinerModelBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Refiner switch" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="RefinerSwitchBox" Value="0.8" Minimum="0" Maximum="1" SmallChange="0.05"
                                                   AutomationProperties.AutomationId="RenderRefinerSwitchBox" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="EnableRefinerToggle"
                                                  Grid.Row="5"
                                                  Header="Enable refiner"
                                                  AutomationProperties.AutomationId="RenderEnableRefinerToggle" />
                                    <ToggleSwitch x:Name="FaceRestoreToggle"
                                                  Grid.Row="5"
                                                  Grid.Column="1"
                                                  Header="Face restoration"
                                                  AutomationProperties.AutomationId="RenderFaceRestoreToggle" />
                                    <StackPanel Grid.Row="6" Spacing="4">
                                        <TextBlock Text="Source image strength" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="SourceStrengthBox" Value="0.55" Minimum="0.05" Maximum="0.95" SmallChange="0.05"
                                                   AutomationProperties.AutomationId="RenderSourceStrengthBox" />
                                    </StackPanel>
                                </Grid>
                            </Expander>

                            <Expander Header="Temporal and motion controls"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="InternalMotionExpander">
                                <Grid Padding="12" ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Duration (seconds)" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="DurationBox" Value="5" Minimum="0.5" Maximum="120" SmallChange="0.5"
                                                   AutomationProperties.AutomationId="RenderDurationBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Video-model max frames / scene" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="FramesBox" Value="25" Minimum="2" Maximum="96"
                                                   AutomationProperties.AutomationId="RenderFramesBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Motion strength" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="MotionStrengthBox" Value="1" Minimum="0" Maximum="4" SmallChange="0.1"
                                                   AutomationProperties.AutomationId="RenderMotionStrengthBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Temporal consistency" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="TemporalConsistencyBox" Value="0.75" Minimum="0.01" Maximum="0.99" SmallChange="0.05"
                                                   AutomationProperties.AutomationId="RenderTemporalConsistencyBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="4">
                                        <TextBlock Text="Motion source" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="MotionSourceBox" PlaceholderText="Optional motion asset"
                                                 AutomationProperties.AutomationId="RenderMotionSourceBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Interpolation" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="InterpolationComboBox"
                                                  SelectedIndex="0"
                                                  AutomationProperties.AutomationId="RenderInterpolationComboBox">
                                            <ComboBoxItem Content="Automatic" Tag="auto" />
                                            <ComboBoxItem Content="FFmpeg minterpolate" Tag="minterpolate" />
                                            <ComboBoxItem Content="FPS conversion" Tag="fps" />
                                            <ComboBoxItem Content="RIFE" Tag="rife" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Spacing="4">
                                        <TextBlock Text="Temporal mode" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="TemporalModeComboBox" SelectedIndex="1"
                                                  SelectionChanged="ModelGuidanceSelection_Changed"
                                                  AutomationProperties.AutomationId="RenderTemporalModeComboBox">
                                            <ComboBoxItem Content="off" />
                                            <ComboBoxItem Content="keyframes" />
                                            <ComboBoxItem Content="frame_img2img" />
                                            <ComboBoxItem Content="video_model" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Video model engine" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="VideoModelEngineComboBox" SelectedIndex="0"
                                                  SelectionChanged="ModelGuidanceSelection_Changed"
                                                  AutomationProperties.AutomationId="RenderVideoModelEngineComboBox">
                                            <ComboBoxItem Content="auto" />
                                            <ComboBoxItem Content="animatediff" />
                                            <ComboBoxItem Content="svd" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="Video model ID" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="VideoModelBox"
                                                 PlaceholderText="Optional downloaded AnimateDiff or SVD model ID"
                                                 TextChanged="ModelGuidanceText_Changed"
                                                 AutomationProperties.AutomationId="RenderVideoModelBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="Parseq manifest (optional JSON)" Style="{StaticResource FieldLabelStyle}" />
                                        <ToggleSwitch x:Name="ParseqToggle" Header="Enable Parseq schedules" IsOn="True"
                                                      AutomationProperties.AutomationId="RenderParseqToggle" />
                                        <TextBox x:Name="ParseqBox"
                                                 AcceptsReturn="True"
                                                 MinHeight="110"
                                                 TextWrapping="Wrap"
                                                 PlaceholderText="JSON object"
                                                 AutomationProperties.AutomationId="RenderParseqBox" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LoopToggle"
                                                  Grid.Row="6"
                                                  Header="Loop output"
                                                  AutomationProperties.AutomationId="RenderLoopToggle" />
                                    <ToggleSwitch x:Name="IncludeAudioToggle"
                                                  Grid.Row="6"
                                                  Grid.Column="1"
                                                  Header="Include audio"
                                                  AutomationProperties.AutomationId="RenderIncludeAudioToggle" />
                                </Grid>
                            </Expander>

                            <Expander Header="Motion refinement"
                                      Style="{StaticResource WorkflowExpanderStyle}"
                                      AutomationProperties.AutomationId="InternalMotionRefinementExpander">
                                <Grid Padding="12" ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Keyframe interval (seconds)" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="KeyframeIntervalBox" Value="5" Minimum="0.5" Maximum="60" SmallChange="0.5"
                                                   AutomationProperties.AutomationId="RenderKeyframeIntervalBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Temporal steps (blank = generation steps)" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="TemporalStepsBox" Minimum="1" Maximum="80"
                                                   AutomationProperties.AutomationId="RenderTemporalStepsBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Refine every N frames" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="RefineEveryBox" Value="1" Minimum="1" Maximum="30"
                                                   AutomationProperties.AutomationId="RenderRefineEveryBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Anchor strength" Style="{StaticResource FieldLabelStyle}" />
