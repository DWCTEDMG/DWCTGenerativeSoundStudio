<Page
    x:Class="EdmgStudio.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings and cloud" />
                <TextBlock Opacity="0.72" Text="Provider routing, transcription, secrets, readiness, and the selected Foundry project." />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" AutomationProperties.AutomationId="SettingsRefreshButton" Click="RefreshButton_Click" Content="Refresh" />
        </Grid>
        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" IsClosable="True" IsOpen="False" />
        <ScrollViewer x:Name="SettingsScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Expander Header="Execution plane" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Windows remains the authoritative backend. Hybrid GPU adds managed WSL2 workers for Linux-preferred models; External Linux changes the backend target separately." TextWrapping="Wrap" />
                        <ComboBox x:Name="ExecutionProfileComboBox" Header="Runtime profile" SelectedIndex="0" AutomationProperties.AutomationId="SettingsExecutionProfile">
                            <ComboBoxItem Content="Standard" Tag="standard" />
                            <ComboBoxItem Content="Hybrid GPU (recommended for AI workstations)" Tag="hybrid_gpu" />
                            <ComboBoxItem Content="External Linux backend" Tag="external_linux" />
                        </ComboBox>
                        <TextBlock x:Name="ExecutionReadinessText" Text="Refresh to inspect WSL worker readiness." TextWrapping="Wrap" />
                        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left">
                            <AppBarButton Label="Save profile" Icon="Save" Click="SaveExecutionProfile_Click" />
                            <AppBarButton Label="Re-probe WSL" Icon="Refresh" Click="ProbeWslExecution_Click" />
                        </CommandBar>
                    </StackPanel>
                </Expander>
                <Expander Header="AI runtime / NVIDIA acceleration" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Automatic uses validated cached engines when beneficial. SD1.5 UNet and VAE decoder can be optimized independently while text encoding and scheduling remain on the existing runtime." TextWrapping="Wrap" />
                        <TextBlock x:Name="RuntimeStateText" AutomationProperties.AutomationId="SettingsRuntimeEvidenceStates" FontWeight="SemiBold" Text="Refresh to inspect runtime evidence." TextWrapping="Wrap" />
                        <TextBlock x:Name="RuntimeEvidenceText" AutomationProperties.AutomationId="SettingsRuntimeEvidenceSummary" Opacity="0.72" TextWrapping="Wrap" />
                        <ComboBox x:Name="RuntimeMode" AutomationProperties.AutomationId="SettingsRuntimeMode" AutomationProperties.Name="Studio runtime mode" Header="Runtime mode" SelectedIndex="0">
                            <x:String>auto</x:String><x:String>compatibility</x:String><x:String>performance</x:String><x:String>pytorch_cuda</x:String><x:String>tensorrt</x:String><x:String>cpu</x:String>
                        </ComboBox>
                        <CheckBox x:Name="RuntimeEnabled" AutomationProperties.AutomationId="SettingsRuntimeEnabled" Content="Enable TensorRT" IsChecked="True" />
                        <CheckBox x:Name="RuntimeBuild" Content="Allow automatic engine builds in Performance mode" IsChecked="True" />
                        <CheckBox x:Name="RuntimeFallback" Content="Allow PyTorch CUDA fallback" IsChecked="True" />
                        <CheckBox x:Name="RuntimeStrict" Content="Strict TensorRT diagnostics (fail instead of fallback)" IsChecked="False" />
                        <ComboBox x:Name="RuntimePrecision" Header="Preferred precision" SelectedIndex="0"><x:String>auto</x:String><x:String>fp16</x:String><x:String>fp32</x:String></ComboBox>
                        <NumberBox x:Name="RuntimeCacheLimit" Header="Maximum cache (GB)" Minimum="1" Maximum="1000" Value="100" />
                        <TextBox x:Name="RuntimePackage" Header="Optional TensorRT SDK folder" PlaceholderText="Empty uses the installed runtime" />
                        <NumberBox x:Name="RuntimeDevice" Header="GPU index for diagnostics / optimization" Minimum="0" Maximum="63" Value="0" />
                        <ComboBox x:Name="RuntimeComponent" Header="Compatible TensorRT target" PlaceholderText="Refresh to load compatible targets" SelectionChanged="RuntimeComponent_SelectionChanged" />
                        <TextBlock Text="Optimize builds and validates a 512 x 512 profile for the selected component. Jobs and cancellation are available in the Studio job queue. Diagnostics are timestamped receipts, not proof that a render used TensorRT." TextWrapping="Wrap" />
                        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left">
                            <AppBarButton Label="Save" Icon="Save" Click="SaveRuntime_Click" />
                            <AppBarButton Label="Diagnostics" Icon="Repair" Click="DiagnoseRuntime_Click" />
                            <AppBarButton x:Name="RuntimeOptimizeButton" Label="Optimize selected" Icon="Play" Click="OptimizeRuntime_Click" IsEnabled="False" />
                            <AppBarButton x:Name="RuntimeOptimizeAllButton" Label="Optimize all compatible" Icon="Download" Click="OptimizeAllRuntime_Click" IsEnabled="False" />
                            <AppBarButton x:Name="RuntimeRebuildButton" Label="Rebuild selected" Icon="Sync" Click="RebuildRuntime_Click" IsEnabled="False" />
                            <AppBarButton x:Name="RuntimeValidateButton" Label="Validate selected" Icon="Accept" Click="ValidateRuntime_Click" IsEnabled="False" />
                            <AppBarButton Label="Refresh" Icon="Refresh" Click="RefreshRuntime_Click" />
                        </CommandBar>
                        <TextBlock x:Name="RuntimeComponentsText" AutomationProperties.AutomationId="SettingsRuntimeComponents" Text="Refresh to see component conversion status." TextWrapping="Wrap" />
                        <TextBox x:Name="RuntimeStatusText" AutomationProperties.AutomationId="SettingsRuntimeEngines" Header="Validated and quarantined engine records" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="320" />
                        <TextBox x:Name="RuntimeEngineId" AutomationProperties.AutomationId="SettingsRuntimeEngineId" Header="Engine ID to clear" />
                        <Button AutomationProperties.AutomationId="SettingsRuntimeClearEngine" Content="Clear selected engine cache" Click="ClearRuntimeEngine_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Expander>
                <Expander Header="Local Director runtime" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Manages the local OpenAI-compatible Qwen endpoint in WSL. This is separate from video-render TensorRT acceleration above." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="LocalRuntimeProgress" Width="18" Height="18" IsActive="False" />
                            <TextBlock x:Name="LocalRuntimeStateText" AutomationProperties.AutomationId="SettingsLocalRuntimeState" FontWeight="SemiBold" Text="Stopped" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="LocalRuntimeDetailsText" AutomationProperties.AutomationId="SettingsLocalRuntimeDetails" FontFamily="Consolas" TextWrapping="Wrap" />
                        <TextBlock x:Name="LocalRuntimeErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left">
                            <AppBarButton x:Name="LocalRuntimeStartButton" AutomationProperties.AutomationId="SettingsLocalRuntimeStart" Label="Start" Icon="Play" Click="LocalRuntimeStart_Click" />
                            <AppBarButton x:Name="LocalRuntimeStopButton" AutomationProperties.AutomationId="SettingsLocalRuntimeStop" Label="Stop" Icon="Stop" Click="LocalRuntimeStop_Click" />
                            <AppBarButton x:Name="LocalRuntimeRestartButton" AutomationProperties.AutomationId="SettingsLocalRuntimeRestart" Label="Restart" Icon="RepeatAll" Click="LocalRuntimeRestart_Click" />
                            <AppBarButton Label="Refresh" Icon="Refresh" Click="LocalRuntimeRefresh_Click" />
                            <AppBarButton Label="Open logs" Icon="OpenFile" Click="LocalRuntimeOpenLogs_Click" />
                            <AppBarButton Label="Test" Icon="Accept" Click="LocalRuntimeTest_Click" />
                        </CommandBar>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="8">
                            <ComboBox x:Name="LocalRuntimeChoice" Header="Runtime">
                                <ComboBoxItem Content="Auto" Tag="Auto" />
                                <ComboBoxItem Content="llama.cpp" Tag="LlamaCpp" />
                                <ComboBoxItem Content="TensorRT-LLM" Tag="TensorRtLlm" />
                            </ComboBox>
                            <ComboBox x:Name="LocalRuntimeSplitMode" Grid.Column="1" Header="llama.cpp split mode">
                                <ComboBoxItem Content="Layer (recommended)" Tag="layer" />
                                <ComboBoxItem Content="Tensor (experimental)" Tag="tensor" />
                                <ComboBoxItem Content="None" Tag="none" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <CheckBox x:Name="LocalRuntimeEnabled" Content="Enable orchestration" IsChecked="True" />
                            <CheckBox x:Name="LocalRuntimeAutoStart" Grid.Column="1" Content="Auto-start" IsChecked="True" />
                            <CheckBox x:Name="LocalRuntimeStopOnExit" Grid.Column="2" Content="Stop owned runtime on exit" IsChecked="True" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <CheckBox x:Name="LocalRuntimeCuda" Content="Use CUDA (no implicit CPU fallback)" IsChecked="True" />
                            <CheckBox x:Name="LocalRuntimeMultiGpu" Grid.Column="1" Content="Use multiple GPUs when available" IsChecked="True" />
                        </Grid>
                        <Expander Header="Advanced local inference profile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBox x:Name="LocalRuntimeDevices" Header="GPU devices" PlaceholderText="Empty = all visible GPUs; example: 0,1" />
                                <TextBox x:Name="LocalRuntimeTensorSplit" Header="llama.cpp tensor split" PlaceholderText="Optional; example: 0.6,0.4" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <NumberBox x:Name="LocalRuntimeTensorParallel" Header="TensorRT tensor parallel size" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="LocalRuntimeContext" Grid.Column="1" Header="Context size" Minimum="1" Maximum="1048576" Value="8192" SpinButtonPlacementMode="Compact" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <NumberBox x:Name="LocalRuntimeLlamaPort" Header="llama.cpp port" Minimum="1" Maximum="65535" Value="8080" SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="LocalRuntimeTensorRtPort" Grid.Column="1" Header="TensorRT-LLM port" Minimum="1" Maximum="65535" Value="8081" SpinButtonPlacementMode="Compact" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <Button AutomationProperties.AutomationId="SettingsLocalRuntimeSave" Content="Save local runtime settings" Click="LocalRuntimeSave_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Expander>
                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Remote control and Quick Controls" />
                        <TextBlock Opacity="0.72" Text="Edit keyboard shortcuts, connect a MIDI input, learn mappings, and assign the eight Timeline Quick Controls." TextWrapping="Wrap" />
                        <ItemsControl x:Name="KeyBindingItems" AutomationProperties.AutomationId="SettingsRemoteControlKeyBindings" />
                        <Button AutomationProperties.AutomationId="SettingsSaveKeyBindings" Click="SaveKeyBindings_Click" Content="Save keybindings" HorizontalAlignment="Left" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <ComboBox x:Name="MidiDeviceComboBox" AutomationProperties.AutomationId="SettingsMidiDevice" Header="MIDI input" DisplayMemberPath="Name" />
                            <Button Grid.Column="1" Click="RefreshMidiButton_Click" Content="Refresh MIDI" VerticalAlignment="Bottom" />
                            <Button Grid.Column="2" Click="ConnectMidiButton_Click" Content="Connect" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <ComboBox x:Name="MidiCommandComboBox" AutomationProperties.AutomationId="SettingsMidiLearnCommand" Header="Learn command" DisplayMemberPath="Name" />
                            <Button Grid.Column="1" Click="LearnMidiButton_Click" Content="Learn MIDI" VerticalAlignment="Bottom" />
                            <Button Grid.Column="2" Click="ClearMidiButton_Click" Content="Clear mappings" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock x:Name="MidiStatusText" Opacity="0.72" Text="No MIDI input selected." TextWrapping="Wrap" />
                        <ItemsControl x:Name="QuickControlItems" AutomationProperties.AutomationId="SettingsQuickControlAssignments" />
                        <Button Click="SaveQuickControls_Click" Content="Save Quick Controls" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="ImportRemoteControl_Click" Content="Import mappings" />
                            <Button Click="ExportRemoteControl_Click" Content="Export mappings" />
                            <Button Click="ResetRemoteControl_Click" Content="Reset defaults" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Appearance" />
                        <TextBlock
                            Opacity="0.72"
                            Text="Choose the native palette used throughout Studio. Windows High Contrast always takes precedence."
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="AppearanceThemeComboBox"
                            AutomationProperties.AutomationId="SettingsAppearanceThemeComboBox"
                            AutomationProperties.Name="Studio appearance"
                            Header="Studio appearance"
                            SelectionChanged="AppearanceThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Studio — teal production" Tag="studio" />
                            <ComboBoxItem Content="Ember — warm editorial" Tag="ember" />
                            <ComboBoxItem Content="Aurora — cool cinematic" Tag="aurora" />
                            <ComboBoxItem Content="Atlas — natural reference" Tag="atlas" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Desktop backend" />
                        <TextBlock
                            Opacity="0.72"
                            Text="Choose whether WinUI supervises the local FastAPI backend or connects to a hosted Studio backend."
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="BackendModeComboBox"
                            AutomationProperties.AutomationId="SettingsBackendModeComboBox"
                            Header="Backend mode"
                            SelectionChanged="BackendModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Managed local backend" Tag="managed" />
                            <ComboBoxItem Content="Remote backend URL" Tag="external" />
                        </ComboBox>
                        <TextBox
                            x:Name="RemoteBackendUrlTextBox"
                            AutomationProperties.AutomationId="SettingsRemoteBackendUrlTextBox"
                            Header="Remote backend URL"
                            PlaceholderText="https://studio-backend.example.com" />
                        <TextBlock
                            x:Name="ActiveBackendText"
                            Opacity="0.68"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="SettingsApplyBackendButton"
                                Click="ApplyBackendButton_Click"
                                Content="Apply backend" />
                            <Button
                                AutomationProperties.AutomationId="SettingsUseManagedBackendButton"
                                Click="UseManagedBackendButton_Click"
                                Content="Use managed local" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Video generation route" />
                        <ComboBox
                            x:Name="VideoRouteComboBox"
                            AutomationProperties.AutomationId="SettingsVideoRouteComboBox"
                            Header="Preferred route"
                            SelectedIndex="0">
                            <x:String>auto</x:String>
                            <x:String>local_gpu</x:String>
                            <x:String>cosmos_cloud</x:String>
                            <x:String>azure_foundry_cloud</x:String>
                            <x:String>comfyui</x:String>
                            <x:String>firefly_cloud</x:String>
                            <x:String>imagineart_cloud</x:String>
                        </ComboBox>
                        <CheckBox x:Name="PreferGpuCheckBox" AutomationProperties.AutomationId="SettingsPreferGpuCheckBox" Content="Prefer local GPU in auto mode" IsChecked="True" />
                        <CheckBox x:Name="CloudFallbackCheckBox" AutomationProperties.AutomationId="SettingsCloudFallbackCheckBox" Content="Allow Cosmos fallback" IsChecked="True" />
                        <TextBlock Opacity="0.68" Text="Proxy rendering is permanently disabled. Rendering uses the local CUDA backend or a configured provider." TextWrapping="Wrap" />
                        <Button AutomationProperties.AutomationId="SettingsSaveRouteButton" Click="SaveRouteButton_Click" Content="Save video route" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Transcription" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <ComboBox x:Name="TranscriptionProviderComboBox" AutomationProperties.AutomationId="SettingsTranscriptionProviderComboBox" Header="Provider" SelectedIndex="0">
                                <x:String>faster_whisper</x:String>
                                <x:String>parakeet</x:String>
                                <x:String>parakeet_nim</x:String>
                            </ComboBox>
                            <ComboBox x:Name="TranscriptionDeviceComboBox" Grid.Column="1" AutomationProperties.AutomationId="SettingsTranscriptionDeviceComboBox" Header="Device" SelectedIndex="0">
                                <x:String>auto</x:String>
                                <x:String>cuda</x:String>
                                <x:String>cpu</x:String>
                            </ComboBox>
                            <ComboBox x:Name="ComputeTypeComboBox" Grid.Column="2" AutomationProperties.AutomationId="SettingsComputeTypeComboBox" Header="Compute type" SelectedIndex="0">
                                <x:String>auto</x:String>
                                <x:String>float16</x:String>
                                <x:String>int8</x:String>
                                <x:String>int8_float16</x:String>
                            </ComboBox>
                        </Grid>
                        <TextBox x:Name="TranscriptionModelTextBox" AutomationProperties.AutomationId="SettingsTranscriptionModelTextBox" Header="Model" PlaceholderText="turbo" />
                        <Button AutomationProperties.AutomationId="SettingsSaveTranscriptionButton" Click="SaveTranscriptionButton_Click" Content="Save transcription settings" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Secure provider secret" />
                        <Grid ColumnDefinitions="220,*,Auto,Auto" ColumnSpacing="8">
                            <ComboBox x:Name="SecretNameComboBox" AutomationProperties.AutomationId="SettingsSecretNameComboBox" SelectedIndex="0">
                                <x:String>hf_token</x:String>
                                <x:String>civitai_api_key</x:String>
                                <x:String>openai_compat_api_key</x:String>
                                <x:String>stability_api_key</x:String>
                                <x:String>nvidia_api_key</x:String>
                                <x:String>nvidia_service_key</x:String>
                                <x:String>azure_foundry_api_key</x:String>
                                <x:String>lightning_api_key</x:String>
                                <x:String>adobe_client_id</x:String>
                                <x:String>adobe_client_secret</x:String>
                                <x:String>imagineart_api_key</x:String>
                            </ComboBox>
                            <PasswordBox x:Name="SecretValueBox" Grid.Column="1" AutomationProperties.AutomationId="SettingsSecretValueBox" PlaceholderText="New value (never displayed after saving)" />
                            <Button Grid.Column="2" AutomationProperties.AutomationId="SettingsSaveSecretButton" Click="SaveSecretButton_Click" Content="Save" />
                            <Button Grid.Column="3" AutomationProperties.AutomationId="SettingsClearSecretButton" Click="ClearSecretButton_Click" Content="Clear" />
                        </Grid>
                        <TextBlock x:Name="SecretStatusText" Opacity="0.68" Text="Secret status is loaded from the backend; values are never returned." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Microsoft Foundry project" />
                        <TextBox
                            x:Name="FoundryProjectTextBox"
                            AutomationProperties.AutomationId="SettingsFoundryProjectTextBox"
                            AutomationProperties.Name="Foundry project name"
                            Header="Project name"
                            MaxLength="200" />
                        <TextBox
                            x:Name="FoundrySubscriptionTextBox"
                            AutomationProperties.AutomationId="SettingsFoundrySubscriptionTextBox"
                            AutomationProperties.Name="Azure subscription"
                            Header="Subscription"
                            MaxLength="200" />
                        <TextBox
                            x:Name="FoundryEndpointTextBox"
                            AutomationProperties.AutomationId="SettingsFoundryEndpointTextBox"
                            AutomationProperties.Name="Foundry project endpoint"
                            Header="Project endpoint"
                            PlaceholderText="https://resource.services.ai.azure.com/api/projects/project-name" />
                        <Button
                            AutomationProperties.AutomationId="SettingsSaveFoundryButton"
                            Click="SaveFoundryButton_Click"
                            Content="Save Foundry metadata"
                            HorizontalAlignment="Left" />
                        <TextBlock Opacity="0.68" Text="Authentication remains backend-managed; no credentials are stored in the WinUI source tree." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="VST3 plugins" />
                        <TextBlock x:Name="Vst3CapabilityText"
                                   AutomationProperties.AutomationId="SettingsVst3CapabilityText"
                                   Text="Checking scanner capability..."
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="Vst3CatalogText" Opacity="0.72" TextWrapping="Wrap" />
                        <TextBox x:Name="Vst3ScanRootsTextBox" AutomationProperties.AutomationId="SettingsVst3ScanRootsTextBox" Header="Scan roots (one folder or .vst3 module per line)"
                                 AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="SettingsAddVst3RootButton" Click="BrowseVst3RootButton_Click" Content="Add folder" />
                            <Button AutomationProperties.AutomationId="SettingsScanVst3Button"
                                    Click="ScanVst3Button_Click" Content="Scan / rescan" />
                            <Button AutomationProperties.AutomationId="SettingsRefreshVst3Button"
                                    Click="RefreshVst3Button_Click" Content="Refresh status" />
                            <Button AutomationProperties.AutomationId="SettingsClearVst3QuarantineButton"
                                    Click="ClearVst3QuarantineButton_Click" Content="Clear quarantine" />
                        </StackPanel>
                        <TextBlock x:Name="Vst3CatalogDetailsText" Opacity="0.68" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Opacity="0.68"
                                   Text="Discovery and processing run outside Studio. Scans occur only when requested. Each active effect uses an isolated worker and deterministically bypasses after a crash or timeout; live AudioGraph playback executes the Core mixer and publishes processed meters."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Support bundle" />
                        <TextBlock
                            Opacity="0.72"
                            Text="Exports allowlisted text diagnostics only. Credentials and local absolute paths are redacted; private audio, video, and images are excluded. Review the ZIP before sharing it."
                            TextWrapping="Wrap" />
                        <Button
                            AutomationProperties.AutomationId="SettingsCreateSupportBundleButton"
                            Click="CreateSupportBundleButton_Click"
                            Content="Create support bundle"
                            HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Backend readiness and hardware" />
                        <TextBox
                            x:Name="DiagnosticsTextBox"
                            AutomationProperties.AutomationId="SettingsDiagnosticsTextBox"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            IsReadOnly="True"
                            MinHeight="280"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <ProgressRing x:Name="BusyRing" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" />
    </Grid>
</Page>
