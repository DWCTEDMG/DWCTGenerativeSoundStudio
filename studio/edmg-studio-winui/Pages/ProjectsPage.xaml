<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdmgStudio.WinUI.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EdmgStudio.WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid MaxWidth="{StaticResource StudioPageMaxWidth}" Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Projects" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="Create a production session, inspect its readiness, and open it in the native Workspace." />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton
                    AutomationProperties.AutomationId="RefreshProjectsButton"
                    Click="Refresh_Click"
                    Icon="Refresh"
                    Label="Refresh" />
            </CommandBar>
        </Grid>

        <InfoBar x:Name="ProjectsInfoBar" Grid.Row="1" IsClosable="True" IsOpen="False" />

        <Border
            Grid.Row="2"
            Padding="18"
            Style="{StaticResource StudioCardStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ProjectNameBox"
                    AutomationProperties.AutomationId="ProjectNameTextBox"
                    AutomationProperties.Name="Project name"
                    Header="Project name"
                    MaxLength="200"
                    PlaceholderText="My Project"
                    Text="My Project" />
                <Button
                    x:Name="CreateProjectButton"
                    Grid.Column="1"
                    Margin="0,24,0,0"
                    AutomationProperties.AutomationId="CreateProjectButton"
                    AutomationProperties.HelpText="Creates the project and opens it in Workspace"
                    Click="CreateProject_Click"
                    Content="Create and open"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing
                    x:Name="ProjectProgress"
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="4,24,0,0"
                    AutomationProperties.Name="Loading projects"
                    IsActive="False" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="Project library" />
                <TextBlock
                    x:Name="ProjectCountText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource StudioMutedTextBrush}"
                    Text="Loading…" />
            </Grid>

            <Grid Grid.Row="1">
                <ListView
                    x:Name="ProjectList"
                    AutomationProperties.AutomationId="ProjectList"
                    AutomationProperties.Name="Studio projects"
                    IsItemClickEnabled="True"
                    ItemClick="ProjectList_ItemClick"
                    ItemsSource="{x:Bind Projects}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ProjectListItem">
                            <Grid Padding="8" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource StudioMutedTextBrush}"
                                        Text="{x:Bind Metadata}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        AutomationProperties.Name="{x:Bind FullIdLabel}"
                                        Foreground="{ThemeResource StudioMutedTextBrush}"
                                        Text="{x:Bind WorkflowStatus}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="{x:Bind Id}"
                                    AutomationProperties.Name="{x:Bind OpenLabel}"
                                    Click="OpenProject_Click"
                                    Content="Open"
                                    Tag="{x:Bind Id}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="ProjectEmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <SymbolIcon Symbol="Folder" />
                    <TextBlock x:Name="ProjectEmptyTitle" FontWeight="SemiBold" Text="No projects yet" />
                    <TextBlock
                        x:Name="ProjectEmptyMessage"
                        Foreground="{ThemeResource StudioMutedTextBrush}"
                        Text="Create your first Studio session above."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
