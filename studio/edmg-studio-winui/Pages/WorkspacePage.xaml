<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdmgStudio.WinUI.Pages.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EdmgStudio.WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource StudioBackgroundBrush}">
        <Image
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="{ThemeResource StudioWorkspaceArtworkOpacity}"
            Source="ms-appx:///Assets/Brand/WorkspaceFlair.jpg"
            Stretch="UniformToFill" />
        <Rectangle
            IsHitTestVisible="False"
            Fill="{ThemeResource StudioWorkspaceScrimBrush}" />
        <ScrollViewer>
        <Grid MaxWidth="{StaticResource StudioPageMaxWidth}" Padding="24" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Workspace" />
                    <TextBlock
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="Ingest, analyze, shape creative direction, and hand the session off to Timeline and Render." />
                </StackPanel>
                <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right">
                    <AppBarButton
                        AutomationProperties.AutomationId="RefreshWorkspaceButton"
                        Click="Refresh_Click"
                        Icon="Refresh"
                        Label="Refresh" />
                </CommandBar>
            </Grid>

            <InfoBar
                x:Name="WorkspaceInfoBar"
                Grid.Row="1"
                AutomationProperties.LiveSetting="Assertive"
                IsClosable="True"
                IsOpen="False" />

            <StackPanel Grid.Row="2" Spacing="8">
                <ProgressBar
                    x:Name="OperationProgress"
                    AutomationProperties.Name="Studio operation in progress"
                    IsIndeterminate="True"
                    ShowError="False"
                    ShowPaused="False"
                    Visibility="Collapsed" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OperationStatusText" Text="Ready" TextWrapping="Wrap" />
                    <Button
                        x:Name="CancelOperationButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="CancelOperationButton"
                        Click="CancelOperation_Click"
                        Content="Stop waiting"
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>

            <Grid x:Name="WorkspaceGrid" Grid.Row="3" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="WorkflowColumn" Spacing="12">
                    <Expander Header="1. Project" IsExpanded="True">
                        <StackPanel Padding="0,10,0,8" Spacing="8">
                            <ComboBox
                                x:Name="ProjectPicker"
                                AutomationProperties.AutomationId="ProjectPickerComboBox"
                                AutomationProperties.Name="Active Studio project"
                                DisplayMemberPath="Name"
                                Header="Active project"
                                ItemsSource="{x:Bind Projects}"
                                PlaceholderText="Choose a project"
                                SelectionChanged="ProjectPicker_SelectionChanged" />
                            <TextBlock
                                x:Name="NoProjectsText"
                                Foreground="{ThemeResource StudioMutedTextBrush}"
                                Text="No projects yet. Create one in Projects."
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <Button
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="ProjectsButton"
                                Click="OpenProjects_Click"
                                Content="Open Projects" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="2. Audio and analysis" IsExpanded="True">
                        <StackPanel Padding="0,10,0,8" Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="ChooseAudioButton"
                                    AutomationProperties.AutomationId="ChooseAudioButton"
                                    AutomationProperties.HelpText="Choose a WAV, MP3, FLAC, M4A, AAC, OGG, or WMA audio track"
                                    Click="ChooseAudio_Click"
                                    Content="Choose audio" />
                                <TextBlock
                                    x:Name="PendingAudioText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource StudioMutedTextBrush}"
                                    Text="No local file selected"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="Selected local audio file" />
                            </Grid>
                            <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                                <AppBarButton
                                    x:Name="UploadButton"
                                    AutomationProperties.AutomationId="UploadAudioButton"
                                    Click="Upload_Click"
                                    Icon="Upload"
                                    IsEnabled="False"
                                    Label="Upload" />
                                <AppBarButton
                                    x:Name="AnalyzeButton"
                                    AutomationProperties.AutomationId="AnalyzeAudioButton"
                                    Click="Analyze_Click"
                                    Icon="Play"
                                    IsEnabled="False"
                                    Label="Analyze + Transcribe" />
                            </CommandBar>
                            <Grid ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Saved track" />
                                <TextBlock x:Name="SavedAudioText" Grid.Column="1" Text="None" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Analysis" />
                                <TextBlock x:Name="AnalysisStateText" Grid.Row="1" Grid.Column="1" Text="Pending" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Tempo" />
                                <TextBlock x:Name="TempoText" Grid.Row="2" Grid.Column="1" Text="—" />
                                <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Duration / sections" />
                                <TextBlock x:Name="DurationSectionsText" Grid.Row="3" Grid.Column="1" Text="—" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="3. Plan variants" IsExpanded="True">
                        <StackPanel Padding="0,10,0,8" Spacing="10">
                            <ComboBox x:Name="PlanModePicker"
                                      AutomationProperties.AutomationId="PlanModeComboBox"
                                      Header="Planning mode"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Auto — AI with local fallback" Tag="auto" />
                                <ComboBoxItem Content="AI-only" Tag="ai" />
                                <ComboBoxItem Content="Local-only" Tag="local" />
                            </ComboBox>
                            <Button
                                x:Name="GeneratePlanButton"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="GeneratePlanButton"
                                AutomationProperties.HelpText="Requires current audio analysis"
                                Click="GeneratePlan_Click"
                                Content="Generate Plan Variants"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                            <TextBlock
                                x:Name="PlanEmptyText"
                                Foreground="{ThemeResource StudioMutedTextBrush}"
                                Text="Analyze the current track before generating a plan."
                                TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{x:Bind Variants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:VariantListItem">
                                        <Grid Padding="8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource StudioMutedTextBrush}"
                                                    Text="{x:Bind Description}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <RadioButton
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="{x:Bind SelectLabel}"
                                                AutomationProperties.Name="{x:Bind SelectLabel}"
                                                Checked="Variant_Checked"
                                                GroupName="PlanVariants"
                                                IsChecked="{x:Bind IsSelected, Mode=OneTime}"
                                                Tag="{x:Bind Index}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Expander Header="4. Handoff" IsExpanded="True">
                        <StackPanel Padding="0,10,0,8" Spacing="8">
                            <TextBlock
                                x:Name="HandoffText"
                                Text="Generate a plan to unlock Timeline and Render handoff."
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="TimelineButton"
                                        AutomationProperties.AutomationId="OpenTimelineButton"
                                        Click="Timeline_Click"
                                        Content="Open Timeline"
                                        IsEnabled="False" />
                                <Button x:Name="RenderButton"
                                        AutomationProperties.AutomationId="OpenRenderButton"
                                        Click="Render_Click"
                                        Content="Go to Render"
                                        IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <Border
                    x:Name="SessionStatusCard"
                    Grid.Column="1"
                    Padding="20"
                    VerticalAlignment="Top"
                    Style="{StaticResource StudioCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="Studio session" />
                        <TextBlock x:Name="SessionProjectText" FontWeight="SemiBold" Text="Project: none" TextWrapping="Wrap" />
                        <TextBlock x:Name="SessionAudioText" Text="Audio: missing" />
                        <TextBlock x:Name="SessionAnalysisText" Text="Analysis: pending" />
                        <TextBlock x:Name="SessionPlanText" Text="Plan: pending" />
                        <TextBlock x:Name="SessionVariantText" Text="Variant: none" TextWrapping="Wrap" />
                        <Rectangle Height="1" Fill="{ThemeResource StudioBorderBrush}" />
                        <TextBlock FontWeight="SemiBold" Text="Backend" />
                        <TextBlock x:Name="SessionBackendText" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SessionStatusCard.(Grid.Column)" Value="0" />
                                <Setter Target="SessionStatusCard.(Grid.Row)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="960" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SessionStatusCard.(Grid.Column)" Value="1" />
                                <Setter Target="SessionStatusCard.(Grid.Row)" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
