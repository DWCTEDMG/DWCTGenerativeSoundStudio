                                                AutomationProperties.AutomationId="Timeline.Post.Adr.ApplyReview" />
                                        <Button Content="Record ADR (unavailable)" IsEnabled="False"
                                                AutomationProperties.AutomationId="Timeline.Post.Adr.Record"
                                                AutomationProperties.HelpText="Native audio recording is not implemented. Import a recording as project media, then register it as a take." />
                                        <TextBlock Text="Native ADR recording is unavailable. Import or pre-record audio into project media, then register it above."
