<Page
    x:Class="EdmgStudio.WinUI.Pages.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EdmgStudio.WinUI.Controls"
    NavigationCacheMode="Enabled">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
        <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="DuplicateAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Timeline" Style="{StaticResource StudioPageTitleTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="ProjectText"
                               Text="Arrange generated clips, preview the edit, and render a master."
                               Style="{StaticResource StudioCaptionTextStyle}" />
                    <TextBlock x:Name="DurationSummaryText"
                               Style="{StaticResource StudioCaptionTextStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <CommandBar x:Name="EditorTrackCommands" DefaultLabelPosition="Right">
                    <AppBarButton Label="Add audio track" Icon="Audio" Click="AddAudioTrack_Click"
                                  AutomationProperties.AutomationId="Timeline.AddAudioTrack" />
                    <AppBarButton Label="Add video track" Icon="Video" Click="AddVideoTrack_Click"
                                  AutomationProperties.AutomationId="Timeline.AddVideoTrack" />
                    <AppBarButton Label="Add marker" Icon="Flag" Click="AddMarker_Click"
                                  AutomationProperties.AutomationId="Timeline.AddMarker" />
                </CommandBar>
                <Button x:Name="UndoButton"
                        AutomationProperties.AutomationId="Timeline.Undo"
                        Content="Undo"
                        Click="Undo_Click" />
                <Button x:Name="RedoButton"
                        AutomationProperties.AutomationId="Timeline.Redo"
                        Content="Redo"
                        Click="Redo_Click" />
                <Button x:Name="SaveButton"
                        AutomationProperties.AutomationId="Timeline.Save"
                        Style="{StaticResource StudioPrimaryButtonStyle}"
                        Content="Save timeline"
                        Click="SaveTimeline_Click" />
                <Button AutomationProperties.AutomationId="Timeline.Refresh"
                        Content="Refresh"
                        Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="PageInfoBar"
                 Grid.Row="1"
                 Margin="20,0,20,10"
                 IsOpen="False"
                 IsClosable="True" />

        <Border Grid.Row="2"
                Margin="20,0,20,10"
                Padding="10"
                Style="{StaticResource StudioCardBorderStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="Timeline.PlayPause"
                        MinWidth="74"
                        Content="Play"
                        Click="PlayPause_Click" />
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="Timeline.Stop"
                        Content="Stop"
                        Click="Stop_Click" />
                <Button Grid.Column="2"
                        AutomationProperties.AutomationId="Timeline.StepBackward"
                        Content="-1 frame"
                        Click="StepBackward_Click" />
                <Button Grid.Column="3"
                        AutomationProperties.AutomationId="Timeline.StepForward"
                        Content="+1 frame"
                        Click="StepForward_Click" />
                <TextBlock x:Name="TimecodeText"
                           Grid.Column="4"
                           MinWidth="118"
                           VerticalAlignment="Center"
                           Text="00:00:00.000"
                           FontFamily="Consolas"
                           FontSize="14" />
                <Slider x:Name="PositionSlider"
                        Grid.Column="5"
                        AutomationProperties.AutomationId="Timeline.Position"
                        Minimum="0"
                        Maximum="1"
                        ValueChanged="PositionSlider_ValueChanged"
                        PointerPressed="PositionSlider_PointerPressed"
                        PointerReleased="PositionSlider_PointerReleased" />
                <ToggleButton x:Name="LoopToggle"
                              Grid.Column="6"
                              AutomationProperties.AutomationId="Timeline.Loop"
                              Content="Loop"
                              Checked="LoopControl_Changed"
                              Unchecked="LoopControl_Changed" />
                <NumberBox x:Name="LoopInNumberBox"
                          Grid.Column="7"
                          AutomationProperties.AutomationId="Timeline.LoopIn"
                          Width="76"
                          Minimum="0"
                          PlaceholderText="In"
                          ValueChanged="LoopNumberBox_ValueChanged" />
                <NumberBox x:Name="LoopOutNumberBox"
                          Grid.Column="8"
                          AutomationProperties.AutomationId="Timeline.LoopOut"
                          Width="76"
                          Minimum="0"
                          PlaceholderText="Out"
                          ValueChanged="LoopNumberBox_ValueChanged" />
                <ComboBox x:Name="SnapCombo"
                          Grid.Column="9"
                          AutomationProperties.AutomationId="Timeline.Snap"
                          MinWidth="118"
                          SelectedIndex="1"
                          SelectionChanged="SnapCombo_SelectionChanged">
                    <ComboBoxItem Content="Snap off" Tag="off" />
                    <ComboBoxItem Content="Snap: beat" Tag="beat" />
                    <ComboBoxItem Content="Snap: 1/2 beat" Tag="half" />
                    <ComboBoxItem Content="Snap: 1/4 beat" Tag="quarter" />
                </ComboBox>
                <ToggleButton x:Name="RippleToggle"
                              Grid.Column="10"
                              AutomationProperties.AutomationId="Timeline.Ripple"
                              Content="Ripple"
                              ToolTipService.ToolTip="Shift later clips on the same track after moving, trimming, quantizing, or deleting a clip."
                              Checked="RippleToggle_Changed"
                              Unchecked="RippleToggle_Changed" />
                <StackPanel Grid.Column="11" Orientation="Horizontal" Spacing="4">
                    <ToggleButton x:Name="SelectToolButton"
                                  AutomationProperties.AutomationId="Timeline.ToolSelect"
                                  MinWidth="72"
                                  Content="Select"
                                  ToolTipService.ToolTip="Select, move, and trim timeline clips."
                                  Click="SelectToolButton_Click" />
                    <ToggleButton x:Name="BladeToolButton"
                                  AutomationProperties.AutomationId="Timeline.ToolBlade"
                                  MinWidth="72"
                                  Content="Blade"
                                  ToolTipService.ToolTip="Split a clip by clicking the desired cut point."
                                  Click="BladeToolButton_Click" />
                </StackPanel>
                <Slider x:Name="ZoomSlider"
                        Grid.Column="12"
                        AutomationProperties.AutomationId="Timeline.Zoom"
                        ToolTipService.ToolTip="Timeline zoom. Hold Ctrl and use the mouse wheel over the timeline to zoom around the pointer."
                        Width="108"
                        ValueChanged="ZoomSlider_ValueChanged" />
                <Button Grid.Column="13"
                        AutomationProperties.AutomationId="Timeline.Fit"
                        Content="Fit"
                        Click="FitTimeline_Click" />
                </Grid>
                <StackPanel x:Name="QuickControlsPanel"
                            AutomationProperties.AutomationId="Timeline.QuickControls"
                            Orientation="Horizontal"
                            Spacing="8" />
                <TextBlock x:Name="AudioEngineStatusText"
                           Text="Audio: not configured"
                           Style="{StaticResource StudioCaptionTextStyle}" />
                <Expander Header="Mixer routing and latency" HorizontalAlignment="Stretch"
                          AutomationProperties.AutomationId="Timeline.MixerRouting">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Routing plan only. Native plugin processing and compensation delay buffers are not active."
                                   TextWrapping="Wrap" Style="{StaticResource StudioCaptionTextStyle}" />
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="MixerRoutingText" Text="Load a project to inspect its audio routes."
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="20,0,20,20" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StudioCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{ThemeResource StudioCardBrush}">
                        <TextBlock Margin="12,0"
                                   VerticalAlignment="Center"
                                   Text="TRACKS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="90"
                                   Style="{StaticResource StudioSecondaryTextStyle}" />
                    </Grid>
                    <ScrollViewer x:Name="TrackHeaderScroll"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollMode="Enabled"
                                  ViewChanged="TrackHeaderScroll_ViewChanged">
                        <StackPanel x:Name="TrackHeadersPanel" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StudioCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="RulerScroll"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  HorizontalScrollMode="Enabled">
                        <Canvas x:Name="RulerCanvas"
                                Height="34"
                                Background="{ThemeResource StudioCardBrush}"
                                ToolTipService.ToolTip="Click or drag to scrub the playhead."
                                PointerPressed="RulerCanvas_PointerPressed"
                                PointerMoved="RulerCanvas_PointerMoved"
                                PointerReleased="RulerCanvas_PointerReleased"
                                PointerCanceled="RulerCanvas_PointerCanceled" />
                    </ScrollViewer>
                    <ScrollViewer x:Name="TimelineScroll"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Enabled"
                                  PointerWheelChanged="TimelineScroll_PointerWheelChanged"
                                  ViewChanged="TimelineScroll_ViewChanged"
                                  SizeChanged="TimelineScroll_SizeChanged">
                        <Canvas x:Name="TimelineCanvas"
                                AutomationProperties.AutomationId="Timeline.ClipSurface"
                                AutomationProperties.HelpText="Select clips, press Space to play, use Left and Right to step frames, or press Delete to remove the selection."
                                Background="{ThemeResource StudioCardBrush}"
                                IsTabStop="True"
                                KeyDown="TimelineCanvas_KeyDown"
                                PointerPressed="TimelineCanvas_PointerPressed" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="0" Style="{StaticResource StudioCardBorderStyle}">
                <Pivot x:Name="InspectorPivot" Margin="0">
                    <PivotItem Header="Inspector">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="14" Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="SelectedClipTitle"
                                               Text="No clip selected"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="SelectedClipSubtitle"
                                               Text="Select a clip in the timeline to edit it."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource StudioCaptionTextStyle}" />
                                </StackPanel>

                                <Expander Header="Sample-accurate editing" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8">
                                        <TextBox x:Name="ExactSampleTextBox" Header="Position in project samples"
                                                 AutomationProperties.AutomationId="Timeline.ExactSamplePosition" />
                                        <TextBlock Text="Move preserves duration. Split advances the source offset without changing the media."
                                                   TextWrapping="Wrap" Style="{StaticResource StudioCaptionTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="MoveExactButton" Content="Move" Click="MoveExact_Click"
                                                    AutomationProperties.AutomationId="Timeline.MoveExact" />
                                            <Button x:Name="SplitExactButton" Content="Split" Click="SplitExact_Click"
                                                    AutomationProperties.AutomationId="Timeline.SplitExact" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Timeline markers" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8">
                                        <ComboBox x:Name="MarkerComboBox"
                                                  Header="Selected marker"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="MarkerComboBox_SelectionChanged"
                                                  AutomationProperties.AutomationId="Timeline.MarkerSelection" />
                                        <TextBox x:Name="MarkerNameTextBox"
                                                 Header="Marker name"
                                                 PlaceholderText="Marker"
                                                 AutomationProperties.AutomationId="Timeline.MarkerName" />
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <Button Grid.Column="0" Content="Add here" Click="AddMarker_Click"
                                                    AutomationProperties.AutomationId="Timeline.MarkerAddHere" />
                                            <Button x:Name="MoveMarkerButton" Grid.Column="1" Content="Move here" Click="MoveMarker_Click"
                                                    AutomationProperties.AutomationId="Timeline.MarkerMoveHere" />
                                            <Button x:Name="DeleteMarkerButton" Grid.Column="2" Content="Delete" Click="DeleteMarker_Click"
                                                    AutomationProperties.AutomationId="Timeline.MarkerDelete" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LaneNameTextBox"
                                             Grid.Column="0"
                                             AutomationProperties.AutomationId="Timeline.Inspector.Name"
                                             Header="Name" />
                                    <TextBox x:Name="LaneTypeTextBox"
                                             Grid.Column="1"
                                             AutomationProperties.AutomationId="Timeline.Inspector.Type"
                                             Header="Type" />
                                </Grid>

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <NumberBox x:Name="StartNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Inspector.Start"
                                               Grid.Row="0"
                                               Grid.Column="0"
                                               Header="Start (s)"
                                               Minimum="0"
                                               SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="EndNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Inspector.End"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               Header="End (s)"
                                               Minimum="0"
                                               SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="SourceInNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Inspector.SourceIn"
                                               Grid.Row="1"
                                               Grid.Column="0"
                                               Header="Source in (s)"
                                               Minimum="0"
                                               SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="SourceOutNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Inspector.SourceOut"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Header="Source out (s)"
                                               Minimum="0"
                                               SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="SpeedNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Inspector.Speed"
                                               Grid.Row="2"
                                               Grid.Column="0"
                                               Header="Speed"
                                               Minimum="0.25"
                                               Maximum="4"
                                               SmallChange="0.05"
                                               SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="TrackNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Inspector.Track"
                                               Grid.Row="2"
                                               Grid.Column="1"
                                               Header="Track"
                                               Minimum="1"
                                               SpinButtonPlacementMode="Compact" />
                                </Grid>
                                <TextBlock x:Name="TrackInspectorHintText"
                                           Text="Track clips can move between numbered tracks."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource StudioCaptionTextStyle}" />

                                <TextBox x:Name="SourcePathTextBox"
                                         AutomationProperties.AutomationId="Timeline.Inspector.SourcePath"
                                         Header="Source path"
                                         PlaceholderText="Backend media source" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="VolumeNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Inspector.Volume"
                                               Grid.Column="0"
                                               Header="Volume"
                                               Minimum="0"
                                               Maximum="2"
                                               SmallChange="0.05"
                                               SpinButtonPlacementMode="Compact" />
                                    <ToggleSwitch x:Name="MutedToggle"
                                                  AutomationProperties.AutomationId="Timeline.Inspector.Muted"
                                                  Grid.Column="1"
                                                  Header="Muted"
                                                  VerticalAlignment="Bottom" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="FadeInNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Inspector.FadeIn"
                                               Grid.Column="0"
                                               Header="Fade in (s)"
                                               Minimum="0"
                                               SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="FadeOutNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Inspector.FadeOut"
                                               Grid.Column="1"
                                               Header="Fade out (s)"
                                               Minimum="0"
                                               SpinButtonPlacementMode="Compact" />
                                </Grid>

                                <Expander x:Name="VideoAdjustmentsExpander"
                                          Header="Video adjustments"
                                          AutomationProperties.AutomationId="Timeline.Inspector.VideoAdjustments">
                                    <StackPanel Padding="0,10,0,0" Spacing="10">
                                        <TextBlock x:Name="VideoAdjustmentHintText"
                                                   Text="These nondestructive adjustments are saved with the clip and applied to the edited master."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource StudioCaptionTextStyle}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="FitModeComboBox"
                                                      Grid.Column="0"
                                                      Header="Frame fit"
                                                      SelectedIndex="0"
                                                      AutomationProperties.AutomationId="Timeline.Inspector.FitMode">
                                                <ComboBoxItem Content="Contain — letterbox" Tag="contain" />
                                                <ComboBoxItem Content="Cover — crop to fill" Tag="cover" />
                                                <ComboBoxItem Content="Stretch" Tag="stretch" />
                                            </ComboBox>
                                            <ComboBox x:Name="RotationComboBox"
                                                      Grid.Column="1"
                                                      Header="Rotation"
                                                      SelectedIndex="0"
                                                      AutomationProperties.AutomationId="Timeline.Inspector.Rotation">
                                                <ComboBoxItem Content="0°" Tag="0" />
                                                <ComboBoxItem Content="90° clockwise" Tag="90" />
                                                <ComboBoxItem Content="180°" Tag="180" />
                                                <ComboBoxItem Content="270° clockwise" Tag="270" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <NumberBox x:Name="OpacityNumberBox"
                                                       Grid.Row="0"
                                                       Grid.Column="0"
                                                       Header="Opacity"
                                                       Minimum="0"
                                                       Maximum="1"
                                                       SmallChange="0.05"
                                                       Value="1"
                                                       SpinButtonPlacementMode="Compact"
                                                       AutomationProperties.AutomationId="Timeline.Inspector.Opacity" />
                                            <NumberBox x:Name="BrightnessNumberBox"
                                                       Grid.Row="0"
                                                       Grid.Column="1"
                                                       Header="Brightness"
                                                       Minimum="-1"
                                                       Maximum="1"
                                                       SmallChange="0.05"
                                                       Value="0"
                                                       SpinButtonPlacementMode="Compact"
                                                       AutomationProperties.AutomationId="Timeline.Inspector.Brightness" />
                                            <NumberBox x:Name="ContrastNumberBox"
                                                       Grid.Row="1"
                                                       Grid.Column="0"
                                                       Header="Contrast"
                                                       Minimum="0"
                                                       Maximum="2"
                                                       SmallChange="0.05"
                                                       Value="1"
                                                       SpinButtonPlacementMode="Compact"
                                                       AutomationProperties.AutomationId="Timeline.Inspector.Contrast" />
                                            <NumberBox x:Name="SaturationNumberBox"
                                                       Grid.Row="1"
                                                       Grid.Column="1"
                                                       Header="Saturation"
                                                       Minimum="0"
                                                       Maximum="3"
                                                       SmallChange="0.05"
                                                       Value="1"
                                                       SpinButtonPlacementMode="Compact"
                                                       AutomationProperties.AutomationId="Timeline.Inspector.Saturation" />
                                        </Grid>
                                        <ToggleSwitch x:Name="FlipHorizontalToggle"
                                                      Header="Mirror horizontally"
                                                      AutomationProperties.AutomationId="Timeline.Inspector.FlipHorizontal" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox x:Name="VideoLookComboBox"
                                                      Header="Quick look"
                                                      SelectedIndex="0"
                                                      AutomationProperties.AutomationId="Timeline.Inspector.VideoLook">
                                                <ComboBoxItem Content="Neutral" Tag="neutral" />
                                                <ComboBoxItem Content="Punchy" Tag="punchy" />
                                                <ComboBoxItem Content="Soft" Tag="soft" />
                                                <ComboBoxItem Content="Monochrome" Tag="monochrome" />
                                            </ComboBox>
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Bottom"
                                                    Content="Apply look"
                                                    Click="ApplyVideoLook_Click"
                                                    AutomationProperties.AutomationId="Timeline.Inspector.ApplyVideoLook" />
                                            <Button Grid.Column="2"
                                                    VerticalAlignment="Bottom"
                                                    Content="Reset"
                                                    Click="ResetVideoAdjustments_Click"
                                                    AutomationProperties.AutomationId="Timeline.Inspector.ResetVideoAdjustments" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Button x:Name="ApplyInspectorButton"
                                        AutomationProperties.AutomationId="Timeline.ApplyInspector"
                                        Style="{StaticResource StudioPrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Content="Apply clip changes"
                                        Click="ApplyInspector_Click" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            AutomationProperties.AutomationId="Timeline.AddClip"
                                            HorizontalAlignment="Stretch"
                                            Content="Add clip here"
                                            Click="AddClipAtPlayhead_Click" />
                                    <Button Grid.Column="1"
                                            AutomationProperties.AutomationId="Timeline.AddOverlay"
                                            HorizontalAlignment="Stretch"
                                            Content="Add overlay here"
                                            Click="AddOverlayAtPlayhead_Click" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="MoveClipButton"
                                            Grid.Column="0"
                                            AutomationProperties.AutomationId="Timeline.MoveToPlayhead"
                                            HorizontalAlignment="Stretch"
                                            Content="Move to playhead"
                                            Click="MoveSelectedToPlayhead_Click" />
                                    <Button x:Name="QuantizeClipButton"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="Timeline.Quantize"
                                            HorizontalAlignment="Stretch"
                                            Content="Quantize"
                                            Click="QuantizeSelected_Click" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SplitClipButton"
                                            Grid.Column="0"
                                            AutomationProperties.AutomationId="Timeline.Split"
                                            HorizontalAlignment="Stretch"
                                            Content="Split at playhead"
                                            Click="SplitClip_Click" />
                                    <Button x:Name="DuplicateClipButton"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="Timeline.Duplicate"
                                            HorizontalAlignment="Stretch"
                                            Content="Duplicate here"
                                            Click="DuplicateClip_Click" />
                                </Grid>

                                <Button x:Name="DeleteClipButton"
                                        AutomationProperties.AutomationId="Timeline.DeleteSelected"
                                        Style="{StaticResource StudioDangerButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Content="Delete selected clip"
                                        Click="DeleteSelectedClip_Click" />

                                <controls:Direct3DPreviewControl
                                    x:Name="PreviewSurface"
                                    AutomationProperties.AutomationId="Timeline.PreviewSurface"
                                    Height="260"
                                    HorizontalAlignment="Stretch"
                                    PreviewContext="Timeline frame" />
                                <TextBlock x:Name="PreviewHintText"
                                           Text="Scrub or play to preview the current timeline frame."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource StudioCaptionTextStyle}" />
