                                </Expander>

                                <Expander Header="Reconform" IsExpanded="True">
                                    <StackPanel Spacing="8" Padding="0,8,0,0">
                                        <ComboBox x:Name="PostReconformKindComboBox" Header="Edit kind" SelectedIndex="0"
                                                  AutomationProperties.AutomationId="Timeline.Post.Reconform.Kind">
                                            <ComboBoxItem Content="Insert" Tag="insert" />
                                            <ComboBoxItem Content="Delete" Tag="delete" />
                                            <ComboBoxItem Content="Move" Tag="move" />
                                        </ComboBox>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <TextBox x:Name="PostOldStartTextBox" Grid.Column="0" Header="Old start sample" Text="0" />
                                            <TextBox x:Name="PostOldEndTextBox" Grid.Column="1" Header="Old end sample" Text="0" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <TextBox x:Name="PostNewStartTextBox" Grid.Column="0" Header="New start sample" Text="0" />
                                            <TextBox x:Name="PostNewEndTextBox" Grid.Column="1" Header="New end sample" Text="0" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button x:Name="PreviewPostReconformButton" Grid.Column="0" Content="Preview reconform" Click="PreviewPostReconform_Click"
                                                    AutomationProperties.AutomationId="Timeline.Post.Reconform.Preview" />
                                            <Button x:Name="ApplyPostReconformButton" Grid.Column="1" Content="Apply reconform" Click="ApplyPostReconform_Click"
                                                    IsEnabled="False" AutomationProperties.AutomationId="Timeline.Post.Reconform.Apply" />
                                        </Grid>
                                        <TextBlock x:Name="PostReconformPreviewText" Text="No reconform preview." TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.AutomationId="Timeline.Post.Reconform.Conflicts" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Interchange" IsExpanded="True">
                                    <StackPanel Spacing="8" Padding="0,8,0,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Grid.Column="0" Content="Import canonical post JSON" Click="ImportPostJson_Click" />
                                            <Button Grid.Column="1" Content="Export canonical post JSON" Click="ExportPostJson_Click" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Grid.Column="0" Content="Import CMX3600 EDL" Click="ImportPostCmx_Click" />
                                            <Button Grid.Column="1" Content="Export CMX3600 EDL" Click="ExportPostCmx_Click" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Grid.Column="0" Content="Import ADR CSV" Click="ImportPostAdrCsv_Click" />
                                            <Button Grid.Column="1" Content="Export ADR CSV" Click="ExportPostAdrCsv_Click" />
                                        </Grid>
                                        <TextBlock x:Name="PostCompatibilityText" Text="No interchange report." TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.AutomationId="Timeline.Post.Interchange.Report" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Audio layout metadata" IsExpanded="True">
                                    <StackPanel Spacing="8" Padding="0,8,0,0">
                                        <ComboBox x:Name="PostAudioLayoutComboBox" Header="Layout" SelectedIndex="1"
                                                  SelectionChanged="PostAudioLayout_SelectionChanged"
                                                  AutomationProperties.AutomationId="Timeline.Post.AudioLayout.Layout">
                                            <ComboBoxItem Content="Mono" Tag="mono" />
                                            <ComboBoxItem Content="Stereo" Tag="stereo" />
                                            <ComboBoxItem Content="5.1" Tag="5.1" />
                                            <ComboBoxItem Content="7.1" Tag="7.1" />
                                            <ComboBoxItem Content="Object" Tag="object" />
                                        </ComboBox>
                                        <ComboBox x:Name="PostAudioLayoutMediaComboBox" Header="Project media asset (optional)" DisplayMemberPath="Label" />
                                        <Button x:Name="AddPostAudioLayoutButton" Content="Add layout metadata" Click="AddPostAudioLayout_Click"
                                                AutomationProperties.AutomationId="Timeline.Post.AudioLayout.Add" />
                                        <TextBlock x:Name="PostAudioCapabilityText" Text="Native stereo preview, render, and export are supported."
                                                   TextWrapping="Wrap" AutomationProperties.AutomationId="Timeline.Post.AudioLayout.Capability" />
                                        <Button Content="Add object position (unavailable)" IsEnabled="False"
                                                AutomationProperties.AutomationId="Timeline.Post.AudioObject.Add"
                                                AutomationProperties.HelpText="Object metadata is preserved, but native object controls and DSP are unavailable." />
                                        <TextBlock x:Name="PostAudioLayoutsText" Text="No layout metadata." TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <PivotItem Header="Workflow">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="14" Spacing="14">
                                <InfoBar x:Name="AutomationInfoBar"
                                         AutomationProperties.AutomationId="Timeline.Automation.Status"
                                         IsOpen="False"
                                         IsClosable="True" />
                                <ProgressBar x:Name="AutomationProgressBar"
                                             AutomationProperties.AutomationId="Timeline.Automation.Progress"
                                             IsIndeterminate="True"
                                             Visibility="Collapsed" />
                                <Button x:Name="CancelAutomationButton"
                                        AutomationProperties.AutomationId="Timeline.Automation.Cancel"
                                        Content="Cancel operation"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Click="CancelAutomation_Click" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="WORKSPACE PLAN"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="90"
                                               Style="{StaticResource StudioSecondaryTextStyle}" />
                                    <TextBlock x:Name="WorkspacePlanText"
                                               Text="No Workspace plan variant is selected."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource StudioCaptionTextStyle}" />
                                    <Button x:Name="RefreshWorkflowButton"
                                            AutomationProperties.AutomationId="Timeline.Workflow.RefreshContext"
                                            Content="Refresh plan and assets"
                                            HorizontalAlignment="Stretch"
                                            Click="RefreshWorkflow_Click" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="AppendPlanButton"
                                                Grid.Column="0"
                                                AutomationProperties.AutomationId="Timeline.Workflow.AppendPlan"
                                                Content="Append plan"
                                                HorizontalAlignment="Stretch"
                                                Click="AppendPlan_Click" />
                                        <Button x:Name="OverwritePlanButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="Timeline.Workflow.OverwritePlan"
                                                Content="Overwrite"
                                                Style="{StaticResource StudioDangerButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Click="OverwritePlan_Click" />
                                    </Grid>
                                </StackPanel>

                                <Border Padding="12"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="AI EDIT ASSISTANT"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   CharacterSpacing="90"
                                                   Style="{StaticResource StudioSecondaryTextStyle}" />
                                        <TextBlock Text="Describe the pacing, shot structure, or visual edit you want. The assistant creates a reviewable proposal and never changes the Timeline until you apply it."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource StudioCaptionTextStyle}" />
                                        <TextBox x:Name="AiEditInstructionTextBox"
                                                 AutomationProperties.AutomationId="Timeline.AiEdit.Instruction"
                                                 Header="Editing direction"
                                                 PlaceholderText="Example: Build a fast intro, breathe through the verse, then cut tightly on the final drop."
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="82" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox x:Name="AiEditMaximumScenesNumberBox"
                                                       Grid.Column="0"
                                                       AutomationProperties.AutomationId="Timeline.AiEdit.MaximumScenes"
                                                       Header="Maximum scenes"
                                                       Minimum="1"
                                                       Maximum="64"
                                                       Value="12"
                                                       SpinButtonPlacementMode="Compact" />
                                            <Button x:Name="GenerateAiEditButton"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Bottom"
                                                    AutomationProperties.AutomationId="Timeline.AiEdit.Generate"
                                                    Content="Generate proposal"
                                                    Click="GenerateAiEdit_Click" />
                                        </Grid>
                                        <TextBlock x:Name="AiEditProposalText"
                                                   AutomationProperties.AutomationId="Timeline.AiEdit.Proposal"
                                                   Text="No AI edit proposal has been generated."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource StudioCaptionTextStyle}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="AppendAiEditButton"
                                                    Grid.Column="0"
                                                    AutomationProperties.AutomationId="Timeline.AiEdit.Append"
                                                    Content="Append proposal"
                                                    IsEnabled="False"
                                                    Click="AppendAiEdit_Click" />
                                            <Button x:Name="ReplaceWithAiEditButton"
                                                    Grid.Column="1"
                                                    AutomationProperties.AutomationId="Timeline.AiEdit.Replace"
                                                    Content="Replace Timeline"
                                                    Style="{StaticResource StudioDangerButtonStyle}"
                                                    IsEnabled="False"
                                                    Click="ReplaceWithAiEdit_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="SOURCE ASSIGNMENT"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="90"
                                               Style="{StaticResource StudioSecondaryTextStyle}" />
                                    <ComboBox x:Name="SourceAssetComboBox"
                                              AutomationProperties.AutomationId="Timeline.Workflow.SourceAsset"
                                              Header="Project artifact"
                                              PlaceholderText="Select generated output or reference"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="SourceAssetComboBox_SelectionChanged" />
                                    <Button x:Name="BrowseSourceButton"
                                            AutomationProperties.AutomationId="Timeline.Workflow.BrowseSource"
                                            Content="Choose local source..."
                                            HorizontalAlignment="Stretch"
                                            Click="BrowseSource_Click" />
                                    <TextBlock x:Name="SelectedSourceText"
                                               Text="No source selected."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource StudioCaptionTextStyle}" />
                                    <NumberBox x:Name="NewClipDurationNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Workflow.NewClipDuration"
                                               Header="New clip duration (s)"
                                               Minimum="0.05"
                                               Value="5"
                                               SmallChange="0.5"
                                               SpinButtonPlacementMode="Compact" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="AssignSourceButton"
                                                Grid.Column="0"
                                                AutomationProperties.AutomationId="Timeline.Workflow.AssignSource"
                                                Content="Assign to clip"
                                                HorizontalAlignment="Stretch"
                                                Click="AssignSource_Click" />
                                        <Button x:Name="AddSourceClipButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="Timeline.Workflow.AddSourceClip"
                                                Content="Add at playhead"
                                                HorizontalAlignment="Stretch"
                                                Click="AddSourceClip_Click" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="SCENE LAYOUT"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="90"
                                               Style="{StaticResource StudioSecondaryTextStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="SequenceTrackNumberBox"
                                                   Grid.Column="0"
                                                   AutomationProperties.AutomationId="Timeline.Workflow.SequenceTrack"
                                                   Header="Track"
                                                   Minimum="1"
                                                   Value="1"
                                                   SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="SequenceGapNumberBox"
                                                   Grid.Column="1"
                                                   AutomationProperties.AutomationId="Timeline.Workflow.SequenceGap"
                                                   Header="Gap (s)"
                                                   Minimum="0"
                                                   Value="0"
                                                   SmallChange="0.1"
                                                   SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <NumberBox x:Name="SequenceStartNumberBox"
                                               AutomationProperties.AutomationId="Timeline.Workflow.SequenceStart"
                                               Header="Sequence start (s)"
                                               Minimum="0"
                                               Value="0"
                                               SmallChange="0.5"
                                               SpinButtonPlacementMode="Compact" />
                                    <Button x:Name="SequenceTrackButton"
                                            AutomationProperties.AutomationId="Timeline.Workflow.Sequence"
                                            Content="Sequence track clips"
                                            HorizontalAlignment="Stretch"
                                            Click="SequenceTrack_Click" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="MOTION GRAMMAR"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="90"
                                               Style="{StaticResource StudioSecondaryTextStyle}" />
                                    <ComboBox x:Name="MotionPhraseComboBox"
                                              AutomationProperties.AutomationId="Timeline.Workflow.MotionPhrase"
                                              Header="Phrase"
                                              SelectedIndex="1"
                                              HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Prepare" Tag="prepare" />
                                        <ComboBoxItem Content="Accent" Tag="accent" />
                                        <ComboBoxItem Content="Travel" Tag="travel" />
                                        <ComboBoxItem Content="Settle" Tag="settle" />
                                        <ComboBoxItem Content="Contrast" Tag="contrast" />
                                    </ComboBox>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="MotionStartNumberBox"
                                                   Grid.Column="0"
                                                   AutomationProperties.AutomationId="Timeline.Workflow.MotionStart"
                                                   Header="Start (s)"
                                                   Minimum="0"
                                                   Value="0"
                                                   SmallChange="0.25"
                                                   SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="MotionEndNumberBox"
                                                   Grid.Column="1"
                                                   AutomationProperties.AutomationId="Timeline.Workflow.MotionEnd"
                                                   Header="End (s)"
                                                   Minimum="0.05"
                                                   Value="2"
                                                   SmallChange="0.25"
                                                   SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <ToggleSwitch x:Name="OverwriteMotionToggle"
                                                  AutomationProperties.AutomationId="Timeline.Workflow.OverwriteMotion"
                                                  Header="Replace current Motion track"
                                                  OffContent="Append"
                                                  OnContent="Replace" />
                                    <Button x:Name="ApplyMotionButton"
                                            AutomationProperties.AutomationId="Timeline.Workflow.ApplyMotion"
                                            Content="Apply motion phrase"
                                            HorizontalAlignment="Stretch"
                                            Click="ApplyMotion_Click" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="CONTINUE WORKFLOW"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="90"
                                               Style="{StaticResource StudioSecondaryTextStyle}" />
                                    <Grid ColumnSpacing="6" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button x:Name="OpenWorkspaceButton" Grid.Row="0" Grid.Column="0" AutomationProperties.AutomationId="Timeline.Navigate.Workspace" Content="Workspace" Click="OpenWorkspace_Click" />
                                        <Button x:Name="OpenRenderButton" Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="Timeline.Navigate.Render" Content="Render" Click="OpenRender_Click" />
                                        <Button x:Name="OpenReviewButton" Grid.Row="1" Grid.Column="0" AutomationProperties.AutomationId="Timeline.Navigate.Review" Content="Review" Click="OpenReview_Click" />
                                        <Button x:Name="OpenOutputsButton" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="Timeline.Navigate.Outputs" Content="Outputs" Click="OpenOutputs_Click" />
                                        <Button x:Name="OpenQueueButton" Grid.Row="2" Grid.Column="0" AutomationProperties.AutomationId="Timeline.Navigate.Queue" Content="Queue" Click="OpenQueue_Click" />
                                        <Button x:Name="OpenPlannerButton" Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="Timeline.Navigate.Planner" Content="Planner Lab" Click="OpenPlanner_Click" />
                                        <Button x:Name="OpenReactiveButton" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" AutomationProperties.AutomationId="Timeline.Navigate.Reactive" Content="Reactive Lab" HorizontalAlignment="Stretch" Click="OpenReactive_Click" />
                                    </Grid>
                                </StackPanel>

                                <TextBox x:Name="AutomationResultTextBox"
                                         AutomationProperties.AutomationId="Timeline.Automation.Result"
                                         Header="Last automation result"
                                         MinHeight="130"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <PivotItem Header="Render">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="14" Spacing="12">
                                <TextBlock Text="Render edited master"
                                           Style="{StaticResource StudioSectionTitleTextStyle}" />
                                <TextBlock Text="Uses the saved timeline as the authoritative edit."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource StudioCaptionTextStyle}" />
                                <TextBox x:Name="OutputNameTextBox"
                                         AutomationProperties.AutomationId="Timeline.OutputName"
                                         Header="Output name"
                                         Text="timeline_master" />
