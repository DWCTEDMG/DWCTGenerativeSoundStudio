<Page
    x:Class="EdmgStudio.WinUI.Pages.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:EdmgStudio.WinUI.Controls"
    xmlns:local="using:EdmgStudio.WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,24,32,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Timeline" />
                <TextBlock Foreground="{ThemeResource SecondaryTextBrush}"
                           Text="Arrange clip lanes while preserving all backend timeline metadata." />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton x:Name="RefreshButton" AutomationProperties.AutomationId="Timeline.Refresh"
                              Click="RefreshButton_Click" Icon="Refresh" Label="Refresh" />
                <AppBarButton x:Name="UndoButton" AutomationProperties.AutomationId="Timeline.Undo"
                              Click="UndoButton_Click" Icon="Undo" IsEnabled="False" Label="Undo" />
                <AppBarButton x:Name="RedoButton" AutomationProperties.AutomationId="Timeline.Redo"
                              Click="RedoButton_Click" Icon="Redo" IsEnabled="False" Label="Redo" />
                <AppBarButton x:Name="SaveButton" AutomationProperties.AutomationId="Timeline.Save"
                              Click="SaveButton_Click" Icon="Save" Label="Save" />
                <AppBarButton x:Name="AutosaveButton" AutomationProperties.AutomationId="Timeline.Autosave"
                              Click="AutosaveButton_Click" Icon="Clock" Label="Autosave" />
            </CommandBar>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" Margin="32,0,32,12"
                 IsClosable="True" IsOpen="False" Severity="Informational" />

        <Grid Grid.Row="2" Margin="32,0,32,28" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="480" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Padding="20" Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Clip lanes" />
                            <TextBlock x:Name="ProjectText" Foreground="{ThemeResource SecondaryTextBrush}"
                                       Text="Select a project from Projects or Workspace." />
                        </StackPanel>
                        <Button x:Name="AddLaneButton" Grid.Column="1"
                                AutomationProperties.AutomationId="Timeline.AddLane"
                                Click="AddLaneButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock Text="Add lane" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="Name / type" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Start" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="End" />
                    </Grid>
                    <ListView x:Name="LaneList" Grid.Row="2"
                              AutomationProperties.AutomationId="Timeline.LaneList"
                              ItemsSource="{x:Bind Lanes, Mode=OneWay}"
                              SelectionChanged="LaneList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:TimelineLane">
                                <Grid Padding="0,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox AutomationProperties.AutomationId="{x:Bind NameAutomationId}"
                                             Header="{x:Bind Type}" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox Grid.Column="1" AutomationProperties.AutomationId="{x:Bind StartAutomationId}"
                                               Minimum="0" SmallChange="0.25" SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind StartSeconds, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="2" AutomationProperties.AutomationId="{x:Bind EndAutomationId}"
                                               Minimum="0" SmallChange="0.25" SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind EndSeconds, Mode=TwoWay}" />
                                    <Button Grid.Column="3" Width="36" Height="36"
                                            AutomationProperties.AutomationId="{x:Bind RemoveAutomationId}"
                                            Click="RemoveLaneButton_Click" Tag="{x:Bind}">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
                <Border Padding="18" Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Selected lane monitor" />
                                <TextBlock x:Name="PreviewFrameText"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           Text="Select a lane to preview its start frame."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="PreviewFrameButton" Grid.Column="1"
                                    AutomationProperties.AutomationId="Timeline.PreviewFrame"
                                    Click="PreviewFrameButton_Click"
                                    Content="Refresh frame"
                                    IsEnabled="False" />
                        </Grid>
                        <controls:Direct3DPreviewControl
                            x:Name="TimelinePreview"
                            Height="220"
                            AutomationProperties.AutomationId="Timeline.FramePreview"
                            AutomationProperties.Name="Selected timeline lane Direct3D preview" />
                    </StackPanel>
                </Border>
                <Border Padding="18" Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Recovery" />
                        <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   Text="Inspect the autosave journal and restore it only when needed." />
                        <Button x:Name="CheckRecoveryButton" AutomationProperties.AutomationId="Timeline.CheckRecovery"
                                Click="CheckRecoveryButton_Click" Content="Check recovery state" />
                        <Button x:Name="RestoreRecoveryButton" AutomationProperties.AutomationId="Timeline.RestoreRecovery"
                                Click="RestoreRecoveryButton_Click" Content="Restore journal" IsEnabled="False" />
                        <TextBlock x:Name="RecoveryText" Foreground="{ThemeResource SecondaryTextBrush}"
                                   Text="Recovery state not checked." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Expander Header="Advanced timeline JSON" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0" Spacing="8">
                        <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   Text="Edit unsupported clip, keyframe, motion, and overlay fields without losing them." />
                        <TextBox x:Name="RawTimelineBox" Height="300" AcceptsReturn="True"
                                 AutomationProperties.AutomationId="Timeline.RawJson"
                                 FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Button x:Name="ApplyJsonButton" AutomationProperties.AutomationId="Timeline.ApplyJson"
                                Click="ApplyJsonButton_Click" Content="Apply JSON to lanes" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
