                                                   AutomationProperties.AutomationId="Timeline.Post.Sync.Preview" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="ADR cues and takes" IsExpanded="True">
                                    <StackPanel Spacing="8" Padding="0,8,0,0">
                                        <ListView x:Name="PostAdrCueListView" MaxHeight="130" SelectionMode="Single" DisplayMemberPath="Label"
