                                            <TextBox x:Name="PostAdrStartTextBox" Grid.Column="0" Header="Start sample" Text="0"
                                                     AutomationProperties.AutomationId="Timeline.Post.Adr.Start" />
                                            <TextBox x:Name="PostAdrEndTextBox" Grid.Column="1" Header="End sample" Text="1"
                                                     AutomationProperties.AutomationId="Timeline.Post.Adr.End" />
