                                        <TextBox x:Name="PostAdrTextTextBox" Header="Cue text" AutomationProperties.AutomationId="Timeline.Post.Adr.Text" />
                                        <TextBox x:Name="PostAdrPerformerTextBox" Header="Performer (optional)" AutomationProperties.AutomationId="Timeline.Post.Adr.Performer" />
