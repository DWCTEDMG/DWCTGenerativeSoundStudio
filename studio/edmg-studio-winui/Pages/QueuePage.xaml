<Page
    x:Class="EdmgStudio.WinUI.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,24,32,12" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Render queue" />
                <TextBlock Foreground="{ThemeResource SecondaryTextBrush}"
                           Text="Monitor progress, inspect results, and control backend jobs." />
            </StackPanel>
            <StackPanel x:Name="QueueScopeControls" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ComboBox x:Name="StatusFilterComboBox"
                          Header="Status"
                          MinWidth="140"
                          SelectionChanged="StatusFilterComboBox_SelectionChanged"
                          AutomationProperties.AutomationId="Queue.StatusFilter">
                    <ComboBoxItem Content="All jobs" Tag="All" />
                    <ComboBoxItem Content="Active" Tag="Active" />
                    <ComboBoxItem Content="Waiting" Tag="Queued" />
                    <ComboBoxItem Content="Completed" Tag="Completed" />
                    <ComboBoxItem Content="Needs attention" Tag="Attention" />
                </ComboBox>
                <ToggleSwitch x:Name="AllProjectsSwitch"
                              AutomationProperties.AutomationId="Queue.AllProjects"
                              Header="All projects"
                              Toggled="AllProjectsSwitch_Toggled" />
                <Button x:Name="RefreshButton"
                        AutomationProperties.AutomationId="Queue.Refresh"
                        Click="RefreshButton_Click"
                        Content="Refresh" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="32,0,32,12" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <Border Padding="14" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8">
                <StackPanel><TextBlock Text="Active" Foreground="{ThemeResource SecondaryTextBrush}" /><TextBlock x:Name="ActiveMetricText" Text="0" FontSize="24" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="14" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8">
                <StackPanel><TextBlock Text="Running" Foreground="{ThemeResource SecondaryTextBrush}" /><TextBlock x:Name="RunningMetricText" Text="0" FontSize="24" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="14" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8">
                <StackPanel><TextBlock Text="Completed" Foreground="{ThemeResource SecondaryTextBrush}" /><TextBlock x:Name="CompletedMetricText" Text="0" FontSize="24" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="14" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8">
                <StackPanel><TextBlock Text="Attention" Foreground="{ThemeResource SecondaryTextBrush}" /><TextBlock x:Name="AttentionMetricText" Text="0" FontSize="24" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="2" Margin="32,0,32,12"
                 IsClosable="True" IsOpen="False" />

        <Grid x:Name="QueueWorkspace" Grid.Row="3" Margin="32,0,32,24" ColumnDefinitions="3*,2*" RowDefinitions="Auto,*" ColumnSpacing="20" RowSpacing="20">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideQueue" />
                    <VisualState x:Name="NarrowQueue">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="QueueListBorder.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="QueueDetails.(Grid.Row)" Value="1" />
                            <Setter Target="QueueDetails.(Grid.Column)" Value="0" />
                            <Setter Target="QueueDetails.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideQueueState">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="QueueListBorder" Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8"
                    MinWidth="420">
                <ListView x:Name="JobsList"
                          AutomationProperties.AutomationId="Queue.Jobs"
                          ItemsSource="{x:Bind Jobs}"
                          SelectionChanged="JobsList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,10" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Padding="8,3"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="10">
                                        <TextBlock Text="{Binding StatusLabel}" />
                                    </Border>
                                </Grid>
                                <ProgressBar Grid.Row="1" Minimum="0" Maximum="100"
                                             Value="{Binding Percent}" Visibility="{Binding ProgressVisibility}" />
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Foreground="{ThemeResource SecondaryTextBrush}"
                                               Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Foreground="{ThemeResource SecondaryTextBrush}"
                                               Text="{Binding PriorityLabel}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <ScrollViewer x:Name="QueueDetails" Grid.Column="1" MinWidth="340" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="SelectedJobText" Style="{StaticResource SubtitleTextBlockStyle}" Text="Select a job" />
                    <TextBlock x:Name="SelectedJobSummaryText" Foreground="{ThemeResource SecondaryTextBrush}"
                               Text="Job actions and diagnostic details appear here." TextWrapping="Wrap" />
                    <TextBlock x:Name="SelectedDestinationText" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <InfoBar x:Name="RecommendationBar" IsOpen="False" IsClosable="False" Severity="Informational" />
                    <ProgressBar x:Name="SelectedProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PriorityHighButton" Click="PriorityHighButton_Click" Content="High priority" IsEnabled="False" />
                        <Button x:Name="PriorityNormalButton" Click="PriorityNormalButton_Click" Content="Normal priority" IsEnabled="False" />
                        <Button x:Name="PriorityLowButton" Click="PriorityLowButton_Click" Content="Low priority" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PauseButton" AutomationProperties.AutomationId="Queue.Pause"
                                Click="PauseButton_Click" Content="Pause" IsEnabled="False" />
                        <Button x:Name="ResumeButton" AutomationProperties.AutomationId="Queue.Resume"
                                Click="ResumeButton_Click" Content="Resume" IsEnabled="False" />
                        <Button x:Name="CancelButton" AutomationProperties.AutomationId="Queue.Cancel"
                                Click="CancelButton_Click" Content="Cancel" IsEnabled="False" />
                        <Button x:Name="RetryButton" AutomationProperties.AutomationId="Queue.Retry"
                                Click="RetryButton_Click" Content="Retry" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ResumeCheckpointButton"
                                AutomationProperties.AutomationId="Queue.ResumeCheckpoint"
                                Click="ResumeCheckpointButton_Click"
                                Content="Resume from checkpoint"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Queue a continuation using the selected job's saved checkpoint." />
                        <Button x:Name="RestartCleanButton"
                                AutomationProperties.AutomationId="Queue.RestartClean"
                                Click="RestartCleanButton_Click"
                                Content="Restart clean"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Queue a clean replacement without checkpoint recovery." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ClearCachedFramesButton"
                                AutomationProperties.AutomationId="Queue.ClearCachedFrames"
                                Click="ClearCachedFramesButton_Click"
                                Content="Clear cached frames"
                                IsEnabled="False" />
                        <Button x:Name="DropCheckpointButton"
                                AutomationProperties.AutomationId="Queue.DropCheckpoint"
                                Click="DropCheckpointButton_Click"
                                Content="Drop checkpoint"
                                IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="LogButton" AutomationProperties.AutomationId="Queue.LoadLog"
                                Click="LogButton_Click" Content="Load log" IsEnabled="False" />
                        <Button x:Name="EventsButton" AutomationProperties.AutomationId="Queue.LoadEvents"
                                Click="EventsButton_Click" Content="Load events" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OpenOutputsButton"
                                AutomationProperties.AutomationId="Queue.OpenOutputs"
                                Click="OpenOutputsButton_Click"
                                Content="Outputs"
                                IsEnabled="False" />
                        <Button x:Name="OpenReviewButton"
                                AutomationProperties.AutomationId="Queue.OpenReview"
                                Click="OpenReviewButton_Click"
                                Content="Review"
                                IsEnabled="False" />
                        <Button x:Name="OpenTimelineButton"
                                AutomationProperties.AutomationId="Queue.OpenTimeline"
                                Click="OpenTimelineButton_Click"
                                Content="Insert in timeline"
                                IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Result and diagnostics" />
                    <TextBox x:Name="DetailsTextBox"
                             AutomationProperties.AutomationId="Queue.Details"
                             AcceptsReturn="True"
                             FontFamily="Consolas"
                             IsReadOnly="True"
                             MinHeight="300"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <ProgressRing x:Name="BusyRing" Grid.RowSpan="3"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" />
    </Grid>
</Page>
