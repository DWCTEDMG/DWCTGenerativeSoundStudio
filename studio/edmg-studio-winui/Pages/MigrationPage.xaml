<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdmgStudio.WinUI.Pages.MigrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" Padding="24" Spacing="16">
            <StackPanel Spacing="5">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Migration" />
                <TextBlock
                    Foreground="{ThemeResource StudioMutedTextBrush}"
                    Text="Review legacy desktop state reported by the native bootstrap configuration."
                    TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar
                x:Name="PendingMigrationInfoBar"
                AutomationProperties.AutomationId="Migration.PendingState"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational"
                Title="Migration state" />
            <Border Padding="20" Style="{StaticResource StudioCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Compatibility boundary" />
                    <TextBlock
                        Text="This workflow reports migration state without changing authoritative Python services or silently rewriting project documents. All canonical Studio destinations are available in the native shell."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="Migration.OpenProjects"
                            Click="OpenProjects_Click"
                            Content="Open projects"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            AutomationProperties.AutomationId="Migration.OpenDashboard"
                            Click="OpenDashboard_Click"
                            Content="Open dashboard" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
