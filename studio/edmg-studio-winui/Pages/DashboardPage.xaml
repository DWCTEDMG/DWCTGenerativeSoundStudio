<Page
    x:Class="EdmgStudio.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:EdmgStudio.Core.Models"
    xmlns:local="using:EdmgStudio.WinUI.Pages"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1200"
                    HorizontalAlignment="Stretch"
                    Padding="24"
                    Spacing="20">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource StudioTitleTextBlockStyle}"
                               Text="Studio overview" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Project, pipeline, render, model, and provider health in one place."
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="DashboardRefreshButton"
                        AutomationProperties.Name="Refresh dashboard"
                        Click="OnRefreshClick"
                        Content="Refresh"
                        IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}" />
            </Grid>

            <InfoBar x:Name="StatusBar"
                     IsClosable="True"
                     IsOpen="False"
                     Severity="Informational" />

            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind local:DashboardPage.BoolToVisibility(IsBusy), Mode=OneWay}" />

            <ItemsRepeater ItemsSource="{x:Bind Cards}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinColumnSpacing="12"
                                       MinItemWidth="320"
                                       MinRowSpacing="12"
                                       ItemsJustification="SpaceBetween" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:DashboardCard">
                        <Border MinHeight="150"
                                Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel Spacing="8">
                                <FontIcon HorizontalAlignment="Left"
                                          FontSize="22"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Glyph="{x:Bind Glyph}" />
                                <TextBlock Style="{StaticResource StudioSectionTextBlockStyle}"
                                           Text="{x:Bind Title}" />
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind Value, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           MaxLines="3"
                                           Text="{x:Bind Subtitle, Mode=OneWay}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource StudioSectionTextBlockStyle}"
                               Text="Recent projects" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Open a project or jump directly into its next workflow step."
                               TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar IsOpen="{x:Bind HasNoProjects, Mode=OneWay}"
                         IsClosable="False"
                         Message="Create a project to start building a music-reactive experience."
                         Severity="Informational"
                         Title="No projects yet" />

                <ItemsRepeater ItemsSource="{x:Bind ProjectCards}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinColumnSpacing="12"
                                           MinItemWidth="340"
                                           MinRowSpacing="12"
                                           ItemsJustification="SpaceBetween" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:DashboardProjectItem">
                            <Border MinHeight="340"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid RowDefinitions="142,*">
                                    <Grid Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                        <Image Source="{x:Bind Artwork, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               Visibility="{x:Bind ArtworkVisibility, Mode=OneWay}" />
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="12"
                                                    Visibility="{x:Bind WaveformVisibility, Mode=OneWay}">
                                            <FontIcon HorizontalAlignment="Center"
                                                      FontSize="24"
                                                      Glyph="&#xE189;" />
                                            <ItemsRepeater ItemsSource="{x:Bind Waveform}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="3" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="core:DashboardWaveformBar">
                                                        <Border Width="4"
                                                                Height="{x:Bind Height}"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="2" />
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                        <Border Margin="12"
                                                Padding="8,4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                CornerRadius="12">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{x:Bind HealthLabel}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Padding="18" Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="3">
                                                <TextBlock FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Text="{x:Bind Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Text="{x:Bind UpdatedLabel}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       Text="{x:Bind DurationLabel}" />
                                        </Grid>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   MaxLines="2"
                                                   Text="{x:Bind HealthMessage}"
                                                   TextWrapping="WrapWholeWords" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                                            <TextBlock Grid.Column="1"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind LastRenderLabel}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <CommandBar Background="Transparent"
                                                    DefaultLabelPosition="Collapsed"
                                                    OverflowButtonVisibility="Auto">
                                            <AppBarButton AutomationProperties.Name="Open project workspace"
                                                          Click="OnProjectWorkspaceClick"
                                                          Icon="OpenFile"
                                                          Label="Open"
                                                          Tag="{x:Bind ProjectId}" />
                                            <AppBarButton AutomationProperties.Name="Render project"
                                                          Click="OnProjectRenderClick"
                                                          Icon="Play"
                                                          Label="Render"
                                                          Tag="{x:Bind ProjectId}" />
                                            <AppBarButton AutomationProperties.Name="Review project render"
                                                          Click="OnProjectReviewClick"
                                                          Icon="View"
                                                          IsEnabled="{x:Bind HasRender}"
                                                          Label="Review"
                                                          Tag="{x:Bind ProjectId}" />
                                            <AppBarButton AutomationProperties.Name="Open project outputs"
                                                          Click="OnProjectOutputsClick"
                                                          Icon="Pictures"
                                                          Label="Outputs"
                                                          Tag="{x:Bind ProjectId}" />
                                        </CommandBar>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <Border Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource StudioSectionTextBlockStyle}"
                               Text="Continue your workflow" />
                    <CommandBar DefaultLabelPosition="Right"
                                IsOpen="False"
                                OverflowButtonVisibility="Auto">
                        <AppBarButton AutomationProperties.AutomationId="DashboardOpenProjectsButton"
                                      AutomationProperties.Name="Open projects"
                                      Click="OnOpenProjectsClick"
                                      Icon="Library"
                                      Label="Projects" />
                        <AppBarButton AutomationProperties.AutomationId="DashboardOpenWorkspaceButton"
                                      AutomationProperties.Name="Open active project workspace"
                                      Click="OnOpenWorkspaceClick"
                                      Icon="OpenFile"
                                      IsEnabled="{x:Bind HasActiveProject, Mode=OneWay}"
                                      Label="Workspace" />
                        <AppBarButton AutomationProperties.AutomationId="DashboardOpenTimelineButton"
                                      AutomationProperties.Name="Open active project timeline"
                                      Click="OnOpenTimelineClick"
                                      Icon="Edit"
                                      IsEnabled="{x:Bind HasActiveProject, Mode=OneWay}"
                                      Label="Timeline" />
                        <AppBarButton AutomationProperties.AutomationId="DashboardOpenRenderButton"
                                      AutomationProperties.Name="Open render for active project"
                                      Click="OnOpenRenderClick"
                                      Icon="Play"
                                      IsEnabled="{x:Bind HasActiveProject, Mode=OneWay}"
                                      Label="Render" />
                        <AppBarButton AutomationProperties.AutomationId="DashboardOpenQueueButton"
                                      AutomationProperties.Name="Open render queue"
                                      Click="OnOpenQueueClick"
                                      Icon="Bullets"
                                      Label="Queue" />
                        <AppBarButton AutomationProperties.AutomationId="DashboardOpenOutputsButton"
                                      AutomationProperties.Name="Open active project outputs"
                                      Click="OnOpenOutputsClick"
                                      Icon="Pictures"
                                      IsEnabled="{x:Bind HasActiveProject, Mode=OneWay}"
                                      Label="Outputs" />
                        <AppBarButton AutomationProperties.AutomationId="DashboardOpenModelsButton"
                                      AutomationProperties.Name="Open model manager"
                                      Click="OnOpenModelsClick"
                                      Icon="Download"
                                      Label="Models" />
                    </CommandBar>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
