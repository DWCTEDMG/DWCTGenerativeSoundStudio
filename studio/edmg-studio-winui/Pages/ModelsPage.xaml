<Page
    x:Class="EdmgStudio.WinUI.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Models and providers" />
                <TextBlock x:Name="StorageText" Opacity="0.72" Text="Backend-managed model catalogue, licenses, installs, and runtime lanes." />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" AutomationProperties.AutomationId="ModelsRefreshButton" Click="RefreshButton_Click" Content="Refresh" />
        </Grid>
        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" IsClosable="True" IsOpen="False" />
        <Grid x:Name="ContentGrid" Grid.Row="2" ColumnDefinitions="440,*" ColumnSpacing="20">
            <ListView
                x:Name="ModelsList"
                AutomationProperties.AutomationId="ModelsList"
                ItemsSource="{x:Bind Models}"
                SelectionChanged="ModelsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Opacity="0.68" Text="{Binding Summary}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="SelectedModelText" Style="{StaticResource SubtitleTextBlockStyle}" Text="Select a model" />
                    <TextBlock x:Name="ModelStatusText" Opacity="0.72" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="ModelsAcceptLicenseButton" Click="AcceptLicenseButton_Click" Content="Accept license" />
                        <Button AutomationProperties.AutomationId="ModelsInstallButton" Click="InstallButton_Click" Content="Install" />
                        <Button AutomationProperties.AutomationId="ModelsRestoreButton" Click="RestoreButton_Click" Content="Restore local" />
                        <Button AutomationProperties.AutomationId="ModelsRemoveButton" Click="RemoveButton_Click" Content="Remove user model" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox
                            x:Name="LaneComboBox"
                            AutomationProperties.AutomationId="ModelsLaneComboBox"
                            Header="Runtime lane"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="1">
                            <x:String>stable</x:String>
                            <x:String>recommended</x:String>
                            <x:String>experimental</x:String>
                            <x:String>research</x:String>
                            <x:String>legacy</x:String>
                        </ComboBox>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="ModelsPromoteButton"
                            Click="PromoteButton_Click"
                            Content="Promote" />
                    </Grid>
                    <TextBlock Text="Install a pack" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox
                            x:Name="PackComboBox"
                            AutomationProperties.AutomationId="ModelsPackComboBox"
                            DisplayMemberPath="Name"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Choose a model pack" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ModelsInstallPackButton"
                            Click="InstallPackButton_Click"
                            Content="Install pack" />
                    </Grid>
                    <TextBlock Text="Model metadata" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox
                        x:Name="ModelJsonTextBox"
                        AutomationProperties.AutomationId="ModelsMetadataTextBox"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        MinHeight="280"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <ProgressRing x:Name="BusyRing" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" />
    </Grid>
</Page>
