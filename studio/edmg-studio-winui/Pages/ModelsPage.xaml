<Page
    x:Class="EdmgStudio.WinUI.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Models" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Install, import, benchmark, promote, and migrate models used by the Python/CUDA backend."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="ModelsRefreshButton"
                Click="Refresh_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />
            <ProgressBar
                x:Name="CommandProgress"
                Height="3"
                IsIndeterminate="True"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <TextBox
                        x:Name="SearchBox"
                        AutomationProperties.AutomationId="ModelsSearchBox"
                        Header="Search catalogue"
                        PlaceholderText="Name, ID, source, kind, or lane"
                        TextChanged="SearchBox_TextChanged" />
                    <ComboBox x:Name="ModelFilterComboBox"
                              Header="Show"
                              SelectedIndex="0"
                              SelectionChanged="ModelFilter_SelectionChanged"
                              AutomationProperties.AutomationId="ModelsFilterComboBox">
                        <ComboBoxItem Content="All models" Tag="all" />
                        <ComboBoxItem Content="Installed" Tag="installed" />
                        <ComboBoxItem Content="Runtime ready" Tag="ready" />
                        <ComboBoxItem Content="Video and motion" Tag="video" />
                    </ComboBox>
                    <TextBlock x:Name="CatalogueSummaryText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Loading catalogue..."
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ModelsCatalogueSummaryText" />
                </StackPanel>

                <ListView
                    x:Name="ModelList"
                    Grid.Row="1"
                    MinHeight="180"
                    AutomationProperties.AutomationId="ModelsCatalogList"
                    AutomationProperties.Name="Model catalogue"
                    IsItemClickEnabled="True"
                    ItemClick="ModelList_ItemClick"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Padding="8,3"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <TextBlock FontSize="11" Text="{Binding StateLabel}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    Grid.Row="2"
                    MaxHeight="280"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock FontWeight="SemiBold" Text="Recent tasks" />
                            <TextBlock
                                x:Name="TaskCountText"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock
                            x:Name="NoTasksText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No model tasks yet." />
                        <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TaskItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3" Spacing="3">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    MaxWidth="240"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding StatusLabel}" />
                                                <Button Grid.Column="2"
                                                        Padding="8,2"
                                                        Content="Cancel"
                                                        Click="CancelTask_Click"
                                                        CommandParameter="{Binding Task.Id}"
                                                        IsEnabled="{Binding CanCancel}"
                                                        AutomationProperties.Name="Cancel model task" />
                                            </Grid>
                                            <ProgressBar
                                                Maximum="1"
                                                Value="{Binding Progress}"
                                                Visibility="{Binding ProgressVisibility}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Detail}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="1">
                <StackPanel MaxWidth="920" Spacing="16">
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Name="ModelNameText"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="Select a model" />
                            <TextBlock
                                x:Name="ModelDescriptionText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Choose a catalogue or imported model to view its controls."
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="ModelMetadataText" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="LicenseText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        x:Name="PrimaryActionButton"
                                        Margin="0,0,8,8"
                                        AutomationProperties.AutomationId="ModelsPrimaryActionButton"
                                        Click="PrimaryAction_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="Install" />
                                    <Button
                                        x:Name="AcceptLicenseButton"
                                        Margin="0,0,8,8"
                                        AutomationProperties.AutomationId="ModelsAcceptLicenseButton"
                                        Click="AcceptLicense_Click"
                                        IsEnabled="False"
                                        Content="Review license" />
                                    <Button
                                        x:Name="SmokeTestButton"
                                        Margin="0,0,8,8"
                                        AutomationProperties.AutomationId="ModelsSmokeTestButton"
                                        Click="SmokeTest_Click"
                                        IsEnabled="False"
                                        Content="Run runtime smoke test" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        x:Name="RevalidateButton"
                                        Margin="0,0,8,8"
                                        AutomationProperties.AutomationId="ModelsRevalidateButton"
                                        Click="Revalidate_Click"
                                        IsEnabled="False"
                                        Content="Revalidate files" />
                                    <Button
                                        x:Name="UninstallButton"
                                        Margin="0,0,8,8"
                                        AutomationProperties.AutomationId="ModelsUninstallButton"
                                        Click="Uninstall_Click"
                                        IsEnabled="False"
                                        Content="Uninstall package" />
                                    <Button
                                        x:Name="RemoveButton"
                                        Margin="0,0,8,8"
                                        AutomationProperties.AutomationId="ModelsRemoveButton"
                                        Click="Remove_Click"
                                        IsEnabled="False"
                                        Content="Remove" />
                                    <Button
                                        x:Name="BenchmarkButton"
                                        Margin="0,0,8,8"
                                        AutomationProperties.AutomationId="ModelsBenchmarkButton"
                                        Click="Benchmark_Click"
                                        IsEnabled="False"
                                        Content="Record benchmark" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock FontWeight="SemiBold" Text="Promotion lane" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox
                                    x:Name="LaneCombo"
                                    Width="220"
                                    AutomationProperties.AutomationId="ModelsPromotionLaneComboBox"
                                    Header="Promotion lane"
                                    SelectedIndex="0">
                                    <ComboBoxItem Content="Experimental" Tag="experimental" />
                                    <ComboBoxItem Content="Preview" Tag="preview" />
                                    <ComboBoxItem Content="Production" Tag="production" />
                                </ComboBox>
                                <Button
                                    x:Name="PromoteButton"
                                    AutomationProperties.AutomationId="ModelsPromoteButton"
                                    Click="Promote_Click"
                                    IsEnabled="False"
                                    Content="Promote" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="LtxCard"
                        Visibility="Collapsed"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="LTX-2.5 isolated runtime" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="LTX-2.5 uses a separate Python environment with exactly ltx-pipelines 1.3.0. A valid package, runtime, and supported compute backend are required; VRAM guidance and smoke qualification are advisory." TextWrapping="Wrap" />
                            <TextBox x:Name="LtxPythonBox" Header="LTX Python executable" PlaceholderText="C:\path\to\ltx-venv\Scripts\python.exe" />
                            <NumberBox x:Name="LtxTimeoutBox" Header="Render timeout (seconds)" Minimum="1" Maximum="86400" Value="3600" />
                            <NumberBox x:Name="LtxSmokeTimeoutBox" Header="Smoke-test timeout (seconds)" Minimum="1" Maximum="86400" Value="600" />
                            <TextBlock x:Name="LtxStatusText" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="LtxSaveButton" Click="LtxSave_Click" Content="Save runtime settings" />
                                <Button x:Name="LtxProbeButton" Click="LtxProbe_Click" Content="Probe LTX runtime" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="HunyuanCard"
                        Visibility="Collapsed"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="HunyuanVideo-1.5 Linux runtime" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Hunyuan runs through WSL2 or an external Linux host. Save paths here, then probe the environment before installing or smoke-testing the model." TextWrapping="Wrap" />
                            <ComboBox x:Name="HunyuanModeCombo" Header="Runner" SelectedIndex="0">
                                <ComboBoxItem Content="WSL2" Tag="wsl" />
                                <ComboBoxItem Content="External Linux" Tag="external" />
                            </ComboBox>
                            <TextBox x:Name="HunyuanDistroBox" Header="WSL distribution" PlaceholderText="Ubuntu" />
                            <TextBox x:Name="HunyuanPythonBox" Header="Linux Python" PlaceholderText="/opt/hunyuan/bin/python" />
                            <TextBox x:Name="HunyuanRepoBox" Header="HunyuanVideo-1.5 checkout" PlaceholderText="/opt/HunyuanVideo-1.5" />
                            <TextBox x:Name="HunyuanModelPathBox" Header="Linux model assets (optional override)" Description="Use a native Linux/WSL path to avoid slow repeated model loading through /mnt/c." PlaceholderText="/models/hunyuan-video-1.5" />
                            <NumberBox x:Name="HunyuanTimeoutBox" Header="Render timeout (seconds)" Description="Includes model loading and generation. CPU/group-offloaded Hunyuan runs can take longer than one hour." Minimum="1" Maximum="86400" Value="7200" />
                            <TextBox x:Name="HunyuanLlmBox" Header="Qwen/LLM assets" />
                            <TextBox x:Name="HunyuanByt5Box" Header="ByT5 assets" />
                            <TextBox x:Name="HunyuanGlyphBox" Header="Glyph assets" />
                            <TextBox x:Name="HunyuanVisionBox" Header="Vision assets" />
                            <TextBlock x:Name="HunyuanStatusText" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="HunyuanSaveButton" Click="HunyuanSave_Click" Content="Save runtime settings" />
                                <Button x:Name="HunyuanProbeButton" Click="HunyuanProbe_Click" Content="Probe Linux runtime" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="QwenCard"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Qwen Director runtime" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Automatic placement uses every detected GPU. Choose explicit indexes for isolation; dense and GGUF runtimes preserve their own optimized placement strategies." TextWrapping="Wrap" />
                            <TextBox x:Name="QwenRuntimePathBox" Header="llama.cpp runtime path" PlaceholderText="Path to llama-server.exe" />
                            <TextBox x:Name="QwenGpuDevicesBox" Header="GPU devices" Description="Use auto for every detected GPU, or comma-separated indexes such as 0,2." PlaceholderText="auto" />
                            <ComboBox x:Name="QwenDensePlacementCombo" Header="Dense model placement" SelectedIndex="0">
                                <ComboBoxItem Content="Balanced with GPU 0 headroom" Tag="balanced_low_0" />
                                <ComboBoxItem Content="Balanced" Tag="balanced" />
                                <ComboBoxItem Content="Automatic capacity" Tag="auto" />
                                <ComboBoxItem Content="Sequential" Tag="sequential" />
                            </ComboBox>
                            <TextBox x:Name="QwenGpuLayersBox" Header="GGUF GPU layers" PlaceholderText="auto" />
                            <TextBox x:Name="QwenTensorSplitBox" Header="GGUF tensor split" Description="Use auto for an equal split, or positive comma-separated weights matching the selected GPUs." PlaceholderText="auto" />
                            <NumberBox x:Name="QwenContextBox" Header="Context length" Minimum="8192" Maximum="32768" Value="8192" />
                            <TextBlock x:Name="QwenStatusText" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="QwenSave_Click" Content="Save Qwen settings" />
                                <Button Click="QwenProbe_Click" Content="Probe readiness" />
                                <Button Click="QwenSmoke_Click" Content="Run Level-5 smoke" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="WhisperCard"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Whisper transcription runtime" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Configure the managed Transformers Whisper package. Valid package, dependencies, backend, and settings admit transcription; genuine audio smoke testing adds optional Level-5 qualification evidence." TextWrapping="Wrap" />
                            <ComboBox x:Name="WhisperDeviceCombo" Header="Device" SelectedIndex="0">
                                <ComboBoxItem Content="Auto" Tag="auto" />
                                <ComboBoxItem Content="CUDA" Tag="cuda" />
                                <ComboBoxItem Content="CPU" Tag="cpu" />
                            </ComboBox>
                            <ComboBox x:Name="WhisperComputeCombo" Header="Compute type" SelectedIndex="0">
                                <ComboBoxItem Content="Auto" Tag="auto" />
                                <ComboBoxItem Content="float16" Tag="float16" />
                                <ComboBoxItem Content="int8" Tag="int8" />
                                <ComboBoxItem Content="int8_float16" Tag="int8_float16" />
                            </ComboBox>
                            <TextBlock x:Name="WhisperStatusText" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="WhisperSave_Click" Content="Save Whisper settings" />
                                <Button Click="WhisperProbe_Click" Content="Probe readiness" />
                                <Button Click="WhisperSmoke_Click" Content="Run Level-5 smoke" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Model packs" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Install a curated set of compatible models with required license acceptance handled in one workflow."
                                TextWrapping="Wrap" />
                            <ComboBox
                                x:Name="PackCombo"
                                AutomationProperties.AutomationId="ModelsPackComboBox"
                                DisplayMemberPath="DisplayName"
                                PlaceholderText="Choose a pack"
                                SelectionChanged="PackCombo_SelectionChanged" />
                            <TextBlock
                                x:Name="PackDescriptionText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="PackStatusText"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="InstallPackButton"
                                    Margin="0,0,8,8"
                                    AutomationProperties.AutomationId="ModelsInstallPackButton"
                                    Click="InstallPack_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="Install pack" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Import models" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Import a Civitai model URL or copy a local model file into the backend's managed model folders."
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="CivitaiUrlBox"
                                AutomationProperties.AutomationId="ModelsCivitaiUrlTextBox"
                                Header="Civitai URL"
                                PlaceholderText="https://civitai.com/models/..."
                                TextChanged="CivitaiUrlBox_TextChanged" />
                            <Button
                                x:Name="CivitaiImportButton"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="ModelsCivitaiImportButton"
                                Click="CivitaiImport_Click"
                                IsEnabled="False"
                                Content="Import from Civitai" />
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox
                                    x:Name="LocalFolderCombo"
                                    Width="220"
                                    AutomationProperties.AutomationId="ModelsLocalFolderComboBox"
                                    Header="Model folder"
                                    SelectedIndex="0">
                                    <ComboBoxItem Content="Checkpoints" Tag="checkpoints" />
                                    <ComboBoxItem Content="LoRAs" Tag="loras" />
                                    <ComboBoxItem Content="Embeddings" Tag="embeddings" />
                                    <ComboBoxItem Content="VAE" Tag="vae" />
                                    <ComboBoxItem Content="ControlNet" Tag="controlnet" />
                                </ComboBox>
                                <Button
                                    AutomationProperties.AutomationId="ModelsLocalImportButton"
                                    Click="LocalImport_Click"
                                    Content="Choose local model file" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Component acceleration" />
                            <ComboBox x:Name="ComponentSelector" AutomationProperties.AutomationId="ModelsTensorRtComponent" Header="SD1.5 component" SelectionChanged="ComponentSelector_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="UNet" Tag="unet" />
                                <ComboBoxItem Content="VAE decoder" Tag="vae_decoder" />
                            </ComboBox>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="ComponentDevice" AutomationProperties.AutomationId="ModelsTensorRtDevice" Header="GPU index" Minimum="0" Maximum="63" Value="0" />
                                <ComboBox x:Name="ComponentPrecision" Grid.Column="1" AutomationProperties.AutomationId="ModelsTensorRtPrecision" Header="Precision" SelectedIndex="0">
                                    <x:String>fp16</x:String>
                                    <x:String>fp32</x:String>
                                </ComboBox>
                            </Grid>
                            <TextBlock x:Name="ComponentAccelerationText" AutomationProperties.AutomationId="ModelsComponentAccelerationStatus" Text="Checking component acceleration status..." TextWrapping="Wrap" />
                            <TextBlock x:Name="ComponentAccelerationReasonText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ComponentOptimizeButton" AutomationProperties.AutomationId="ModelsOptimizeSelectedTensorRt" Click="ComponentOptimize_Click" Content="Optimize selected" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="ComponentOptimizeAllButton" AutomationProperties.AutomationId="ModelsOptimizeAllTensorRt" Click="ComponentOptimizeAll_Click" Content="Optimize all compatible" IsEnabled="False" />
                                <Button x:Name="ComponentRebuildButton" AutomationProperties.AutomationId="ModelsRebuildSelectedTensorRt" Click="ComponentRebuild_Click" Content="Rebuild selected" IsEnabled="False" />
                                <Button x:Name="ComponentValidateButton" AutomationProperties.AutomationId="ModelsValidateSelectedTensorRt" Click="ComponentValidate_Click" Content="Validate selected" IsEnabled="False" />
                                <Button x:Name="ComponentDeleteButton" AutomationProperties.AutomationId="ModelsDeleteSelectedTensorRt" Click="ComponentDelete_Click" Content="Delete selected engine" IsEnabled="False" />
                            </StackPanel>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Optimization builds and numerically validates backend-managed profiles. Validate selected reloads and executes the exact cached engine without rebuilding. Unsupported components remain on their existing runtime." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="TensorRtCard"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="TensorRT bundle migration" />
                            <TextBlock
                                x:Name="TensorRtSummaryText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Checking legacy TensorRT bundle status..."
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="TensorRtDiskText" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="TensorRtImportButton"
                                    Margin="0,0,8,8"
                                    AutomationProperties.AutomationId="ModelsTensorRtImportButton"
                                    Click="TensorRtImport_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="Create verified managed copy" />
                                <Button
                                    x:Name="TensorRtCancelButton"
                                    Margin="0,0,8,8"
                                    AutomationProperties.AutomationId="ModelsTensorRtCancelButton"
                                    Click="TensorRtCancel_Click"
                                    IsEnabled="False"
                                    Content="Cancel migration" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Storage" />
                            <TextBlock x:Name="StorageText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
