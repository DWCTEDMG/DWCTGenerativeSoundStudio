<Page
    x:Class="EdmgStudio.WinUI.Pages.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EdmgStudio.WinUI.Controls"
    Unloaded="ReviewPage_Unloaded">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Variant review" />
                <TextBlock x:Name="SummaryText" Opacity="0.72" Text="Compare render variants and persist editorial decisions." />
            </StackPanel>
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="ReviewRefreshButton"
                Click="RefreshButton_Click"
                Content="Refresh" />
        </Grid>
        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" IsClosable="True" IsOpen="False" />
        <Grid x:Name="ReviewWorkspace" Grid.Row="2" ColumnDefinitions="420,*" ColumnSpacing="20">
            <ListView
                x:Name="ArtifactsList"
                AutomationProperties.AutomationId="ReviewArtifactsList"
                ItemsSource="{x:Bind Artifacts}"
                SelectionChanged="ArtifactsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Opacity="0.68" Text="{Binding Summary}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="SelectedArtifactText" Style="{StaticResource SubtitleTextBlockStyle}" Text="Select an artifact" />
                    <TextBlock x:Name="SelectedPathText" Opacity="0.68" TextWrapping="Wrap" />
                    <controls:Direct3DPreviewControl
                        x:Name="ArtifactPreview"
                        Height="300"
                        AutomationProperties.AutomationId="Review.ArtifactPreview"
                        AutomationProperties.Name="Selected review artifact Direct3D preview" />
                    <TextBox
                        x:Name="NotesTextBox"
                        AutomationProperties.AutomationId="ReviewNotesTextBox"
                        Header="Review notes"
                        AcceptsReturn="True"
                        MinHeight="96"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="TraitsTextBox"
                        AutomationProperties.AutomationId="ReviewTraitsTextBox"
                        Header="Cherry-pick traits (comma separated)"
                        PlaceholderText="composition, motion, palette" />
                    <TextBox
                        x:Name="LockFieldsTextBox"
                        AutomationProperties.AutomationId="ReviewLockFieldsTextBox"
                        Header="Locked fields (comma separated)"
                        PlaceholderText="seed, model, prompt" />
                    <TextBlock Text="Decision" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="ReviewApproveButton" Click="ApproveButton_Click" Content="Approve" />
                        <Button AutomationProperties.AutomationId="ReviewRejectButton" Click="RejectButton_Click" Content="Reject" />
                        <Button AutomationProperties.AutomationId="ReviewCherryPickButton" Click="CherryPickButton_Click" Content="Cherry-pick" />
                        <Button AutomationProperties.AutomationId="ReviewClearButton" Click="ClearButton_Click" Content="Clear decision" />
                    </StackPanel>
                    <TextBlock Text="Artifact metadata" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox
                        x:Name="MetadataTextBox"
                        AutomationProperties.AutomationId="ReviewMetadataTextBox"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        MinHeight="220"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <ProgressRing x:Name="BusyRing" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" />
    </Grid>
</Page>
