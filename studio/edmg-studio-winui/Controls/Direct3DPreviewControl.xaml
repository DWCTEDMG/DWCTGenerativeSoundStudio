<UserControl
    x:Class="EdmgStudio.WinUI.Controls.Direct3DPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.Name="Direct3D artifact preview"
    d:DesignHeight="320"
    d:DesignWidth="560"
    Loaded="Direct3DPreviewControl_Loaded"
    Unloaded="Direct3DPreviewControl_Unloaded"
    mc:Ignorable="d">

    <Grid
        MinHeight="220"
        Background="{ThemeResource CardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <SwapChainPanel
            x:Name="PreviewPanel"
            Grid.Row="0"
            SizeChanged="PreviewPanel_SizeChanged" />

        <Border
            x:Name="StateOverlay"
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundBrush}"
            IsHitTestVisible="False">
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    x:Name="StateProgressRing"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="StateText"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="No preview selected."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            x:Name="VideoTransport"
            Grid.Row="1"
            Padding="12,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PlayPauseButton"
                    Width="36"
                    Height="36"
                    AutomationProperties.Name="Play video"
                    Click="PlayPauseButton_Click">
                    <FontIcon
                        x:Name="PlayPauseIcon"
                        FontSize="16"
                        Glyph="&#xE768;" />
                </Button>
                <Slider
                    x:Name="PositionSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="1"
                    StepFrequency="0.1"
                    ValueChanged="PositionSlider_ValueChanged" />
                <TextBlock
                    x:Name="PositionText"
                    Grid.Column="2"
                    MinWidth="96"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Text="00:00 / 00:00"
                    TextAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
