<UserControl
    x:Class="EdmgStudio.WinUI.Controls.Direct3DPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.Name="Direct3D artifact preview"
    d:DesignHeight="320"
    d:DesignWidth="560"
    Loaded="Direct3DPreviewControl_Loaded"
    Unloaded="Direct3DPreviewControl_Unloaded"
    mc:Ignorable="d">

    <Grid
        MinHeight="220"
        Background="{ThemeResource CardBackgroundBrush}">
        <SwapChainPanel
            x:Name="PreviewPanel"
            SizeChanged="PreviewPanel_SizeChanged" />

        <Border
            x:Name="StateOverlay"
            Background="{ThemeResource CardBackgroundBrush}"
            IsHitTestVisible="False">
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    x:Name="StateProgressRing"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="StateText"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="No preview selected."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
