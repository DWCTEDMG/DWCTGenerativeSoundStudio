<UserControl
    x:Class="EdmgStudio.WinUI.Controls.Direct3DPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.Name="Direct3D artifact preview"
    d:DesignHeight="320"
    d:DesignWidth="560"
    Loaded="Direct3DPreviewControl_Loaded"
    Unloaded="Direct3DPreviewControl_Unloaded"
    mc:Ignorable="d">

    <Grid
        x:Name="PreviewRoot"
        MinHeight="160"
        Background="{ThemeResource CardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="PreviewCommandBar"
            Grid.Row="0"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <AppBarButton
                x:Name="DisplayModeButton"
                AutomationProperties.Name="Preview display mode"
                Icon="View">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem
                            x:Name="FitMenuItem"
                            Click="DisplayModeMenuItem_Click"
                            GroupName="PreviewDisplayMode"
                            IsChecked="True"
                            Tag="Fit"
                            Text="Fit" />
                        <RadioMenuFlyoutItem
                            x:Name="FillMenuItem"
                            Click="DisplayModeMenuItem_Click"
                            GroupName="PreviewDisplayMode"
                            Tag="Fill"
                            Text="Fill" />
                        <RadioMenuFlyoutItem
                            x:Name="ActualSizeMenuItem"
                            Click="DisplayModeMenuItem_Click"
                            GroupName="PreviewDisplayMode"
                            Tag="ActualSize"
                            Text="1:1" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarToggleButton
                x:Name="SafeAreasButton"
                AutomationProperties.Name="Show action and title safe areas"
                Click="SafeAreasButton_Click"
                Icon="Crop"
                Label="Safe areas" />
            <AppBarButton
                x:Name="FullScreenButton"
                AutomationProperties.Name="Enter full screen preview"
                Click="FullScreenButton_Click"
                Icon="FullScreen"
                Label="Full screen" />
            <CommandBar.Content>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="PreviewContextText"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Preview" />
                    <Border
                        x:Name="FrameMetadataBadge"
                        Padding="8,3"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="FrameMetadataText"
                            FontFamily="Consolas"
                            FontSize="11" />
                    </Border>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <SwapChainPanel
            x:Name="PreviewPanel"
            Grid.Row="1"
            SizeChanged="PreviewPanel_SizeChanged" />

        <Border
            x:Name="StateOverlay"
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundBrush}"
            IsHitTestVisible="False">
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    x:Name="StateProgressRing"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
                <FontIcon
                    x:Name="StateIcon"
                    HorizontalAlignment="Center"
                    FontSize="24"
                    Glyph="&#xE946;" />
                <TextBlock
                    x:Name="StateText"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="No preview selected."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            x:Name="VideoTransport"
            Grid.Row="2"
            Padding="12,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PlayPauseButton"
                    Width="36"
                    Height="36"
                    AutomationProperties.Name="Play video"
                    Click="PlayPauseButton_Click">
                    <FontIcon
                        x:Name="PlayPauseIcon"
                        FontSize="16"
                        Glyph="&#xE768;" />
                </Button>
                <Slider
                    x:Name="PositionSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="1"
                    StepFrequency="0.1"
                    ValueChanged="PositionSlider_ValueChanged" />
                <TextBlock
                    x:Name="PositionText"
                    Grid.Column="2"
                    MinWidth="96"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Text="00:00 / 00:00"
                    TextAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
