<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="EdmgStudio.WinUI.Controls.StatusCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource StudioCardStyle}" Padding="14">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="StateIcon" VerticalAlignment="Center" FontSize="20" Glyph="&#xE946;" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Text="Status" />
                <TextBlock x:Name="DetailText" Foreground="{ThemeResource StudioMutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter x:Name="ActionPresenter" Grid.Column="2" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
