<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdmgStudio.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EdmgStudio.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource StudioBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image
            Grid.RowSpan="3"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="{ThemeResource StudioArtworkOpacity}"
            Source="ms-appx:///Assets/Brand/StudioBackground.jpg"
            Stretch="UniformToFill" />
        <Rectangle
            Grid.RowSpan="3"
            IsHitTestVisible="False"
            Fill="{ThemeResource StudioContentScrimBrush}" />

        <InfoBar
            x:Name="BackendInfoBar"
            Grid.Row="0"
            Margin="12,8,12,0"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="True"
            IsIconVisible="True"
            Message="Resolving the active backend target before loading Studio data."
            Severity="Informational"
            Title="Connecting to Studio backend" />

        <NavigationView
            x:Name="StudioNavigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="StudioNavigation"
            BackRequested="Navigation_BackRequested"
            CompactModeThresholdWidth="720"
            ExpandedModeThresholdWidth="1120"
            IsBackButtonVisible="Auto"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="260"
            Background="Transparent"
            PaneDisplayMode="Auto"
            PaneTitle=""
            SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.PaneHeader>
                <Border
                    Margin="0,6,0,12"
                    Padding="10"
                    Background="{ThemeResource StudioLogoPanelBrush}"
                    BorderBrush="{ThemeResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="52"
                            Height="52"
                            AutomationProperties.Name="EDMG Studio logo"
                            Source="ms-appx:///Assets/Brand/StudioLogo.png"
                            Stretch="Uniform" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextBrush}"
                                Text="EDMG Studio"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                CharacterSpacing="120"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{ThemeResource StudioAccentSoftBrush}"
                                Text="STUDIO CONTROL" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextBrush}"
                                Text="Create • react • render"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </NavigationView.PaneHeader>

            <NavigationView.PaneFooter>
                <controls:StatusCard
                    x:Name="BackendStatusCard"
                    Margin="8"
                    AutomationProperties.Name="Backend connection status"
                    Detail="http://127.0.0.1:7863"
                    Glyph="&#xE774;"
                    Title="Backend: resolving">
                    <controls:StatusCard.ActionContent>
                        <Button
                            AutomationProperties.AutomationId="ReconnectBackendButton"
                            Click="ReconnectBackend_Click"
                            Content="Reconnect" />
                    </controls:StatusCard.ActionContent>
                </controls:StatusCard>
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Core Flow" />
                <NavigationViewItem AutomationProperties.AutomationId="DashboardNavigationItem" Content="Dashboard" Tag="dashboard" ToolTipService.ToolTip="Status and quick access">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="ProjectsNavigationItem" Content="Projects" Tag="projects" ToolTipService.ToolTip="Create and choose Studio sessions">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="WorkspaceNavigationItem" Content="Workspace" Tag="workspace" ToolTipService.ToolTip="Ingest, analyze, and plan">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="TimelineNavigationItem" Content="Timeline" Tag="timeline" ToolTipService.ToolTip="Arrange full-track visuals and cues">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Delivery" />
                <NavigationViewItem AutomationProperties.AutomationId="RenderNavigationItem" Content="Render" Tag="render" ToolTipService.ToolTip="Launch output generation">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Video" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="QueueNavigationItem" Content="Render Queue" Tag="queue" ToolTipService.ToolTip="Progress, logs, and retries">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge><InfoBadge x:Name="QueueBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="ReviewNavigationItem" Content="Review" Tag="review" ToolTipService.ToolTip="Compare and approve variants">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Preview" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge><InfoBadge x:Name="ReviewBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="OutputsNavigationItem" Content="Outputs" Tag="outputs" ToolTipService.ToolTip="Browse generated media">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Labs" />
                <NavigationViewItem AutomationProperties.AutomationId="DirectorNavigationItem" Content="EDMG Director" Tag="directorLab" ToolTipService.ToolTip="Combined planning and reactive direction">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Target" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="PlannerNavigationItem" Content="AI Planner Lab" Tag="plannerLab" ToolTipService.ToolTip="Deep prompt authoring">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="ReactiveNavigationItem" Content="Reactive Lab" Tag="reactiveLab" ToolTipService.ToolTip="Audio-reactive scheduling">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="StudioForgeNavigationItem" Content="Studio Forge" Tag="studioForge" ToolTipService.ToolTip="Guided builder and readiness preview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="System" />
                <NavigationViewItem AutomationProperties.AutomationId="CloudNavigationItem" Content="Cloud" Tag="cloud" ToolTipService.ToolTip="Remote integrations">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="ModelsNavigationItem" Content="Models" Tag="models" ToolTipService.ToolTip="Model packs and availability">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge><InfoBadge x:Name="ModelsBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="SetupNavigationItem" Content="Setup" Tag="setup" ToolTipService.ToolTip="Dependency and storage readiness">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="MigrationNavigationItem"
                    AutomationProperties.Name="Migration and compatibility"
                    Content="Migration"
                    Tag="migration"
                    ToolTipService.ToolTip="Compatibility and migration workflow">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent" Navigated="ContentFrame_Navigated" />
        </NavigationView>

        <controls:JobProgressCard
            x:Name="GlobalRenderPlayer"
            Grid.Row="2"
            Margin="12,8,12,12"
            CancelRequested="GlobalRenderPlayer_CancelRequested"
            OpenQueueRequested="GlobalRenderPlayer_OpenQueueRequested"
            PauseRequested="GlobalRenderPlayer_PauseRequested"
            Visibility="Collapsed" />
    </Grid>
</Page>
