<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EdmgStudio.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource StudioBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image
            Grid.RowSpan="2"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="{ThemeResource StudioArtworkOpacity}"
            Source="ms-appx:///Assets/Brand/StudioBackground.jpg"
            Stretch="UniformToFill" />
        <Rectangle
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Fill="{ThemeResource StudioContentScrimBrush}" />

        <InfoBar
            x:Name="BackendInfoBar"
            Grid.Row="0"
            Margin="12,8,12,0"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="True"
            IsIconVisible="True"
            Message="Resolving the active backend target before loading Studio data."
            Severity="Informational"
            Title="Connecting to Studio backend" />

        <NavigationView
            x:Name="StudioNavigation"
            Grid.Row="1"
            CompactModeThresholdWidth="720"
            ExpandedModeThresholdWidth="1120"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="260"
            Background="Transparent"
            PaneDisplayMode="Auto"
            PaneTitle="EDMG Studio"
            SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.PaneHeader>
                <Border
                    Margin="0,8,0,12"
                    Padding="8"
                    Background="{ThemeResource StudioLogoPanelBrush}"
                    BorderBrush="{ThemeResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="64"
                            Height="64"
                            AutomationProperties.Name="EDMG Studio logo"
                            Source="ms-appx:///Assets/Brand/StudioLogo.png"
                            Stretch="Uniform" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock
                                CharacterSpacing="120"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{ThemeResource StudioAccentSoftBrush}"
                                Text="STUDIO CONTROL" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextBrush}"
                                Text="Create • react • render"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </NavigationView.PaneHeader>

            <NavigationView.PaneFooter>
                <Border
                    Margin="8"
                    Padding="10"
                    Background="{ThemeResource StudioLogoPanelBrush}"
                    BorderBrush="{ThemeResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="BackendStateText"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextBrush}"
                            Text="Backend: resolving" />
                        <TextBlock
                            x:Name="BackendUriText"
                            AutomationProperties.Name="Active backend address"
                            Foreground="{ThemeResource StudioMutedTextBrush}"
                            Text="http://127.0.0.1:7863"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="Active Studio backend address" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Core Flow" />
                <NavigationViewItem Content="Dashboard" Tag="dashboard" ToolTipService.ToolTip="Status and quick access">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Projects" Tag="projects" ToolTipService.ToolTip="Create and choose Studio sessions">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Workspace" Tag="workspace" ToolTipService.ToolTip="Ingest, analyze, and plan">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Timeline" Tag="timeline" ToolTipService.ToolTip="Arrange full-track visuals and cues">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Delivery" />
                <NavigationViewItem Content="Render" Tag="render" ToolTipService.ToolTip="Launch output generation">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Video" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Render Queue" Tag="queue" ToolTipService.ToolTip="Progress, logs, and retries">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Review" Tag="review" ToolTipService.ToolTip="Compare and approve variants">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Preview" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Outputs" Tag="outputs" ToolTipService.ToolTip="Browse generated media">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Labs" />
                <NavigationViewItem Content="EDMG Director" Tag="directorLab" ToolTipService.ToolTip="Combined planning and reactive direction">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Target" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI Planner Lab" Tag="plannerLab" ToolTipService.ToolTip="Deep prompt authoring">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Reactive Lab" Tag="reactiveLab" ToolTipService.ToolTip="Audio-reactive scheduling">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="System" />
                <NavigationViewItem Content="Cloud" Tag="cloud" ToolTipService.ToolTip="Remote integrations">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Models" Tag="models" ToolTipService.ToolTip="Model packs and availability">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Setup" Tag="setup" ToolTipService.ToolTip="Dependency and storage readiness">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Page>
