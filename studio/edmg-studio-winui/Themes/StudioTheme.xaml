<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="StudioBackgroundBrush" Color="#041417" />
            <SolidColorBrush x:Key="StudioCardBrush" Color="#D1071719" />
            <SolidColorBrush x:Key="StudioBorderBrush" Color="#4746D6E0" />
            <SolidColorBrush x:Key="StudioTextBrush" Color="#EEF5F4" />
            <SolidColorBrush x:Key="StudioMutedTextBrush" Color="#AEBAA8" />
            <SolidColorBrush x:Key="StudioAccentBrush" Color="#35D8DF" />
            <SolidColorBrush x:Key="StudioAccentForegroundBrush" Color="#041417" />
            <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="#94B7D8" />
            <SolidColorBrush x:Key="StudioSuccessBrush" Color="#6FF0BA" />
            <SolidColorBrush x:Key="StudioDangerBrush" Color="#FF7A66" />
            <SolidColorBrush x:Key="StudioNavigationPaneBrush" Color="#F2051113" />
            <SolidColorBrush x:Key="StudioLogoPanelBrush" Color="#E6051113" />
            <SolidColorBrush x:Key="StudioTitleBarBrush" Color="#B8051113" />
            <LinearGradientBrush x:Key="StudioContentScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#A303080B" />
                <GradientStop Offset="0.36" Color="#D9041417" />
                <GradientStop Offset="1" Color="#F7041417" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="StudioWorkspaceScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#72040C10" />
                <GradientStop Offset="0.44" Color="#D1040C10" />
                <GradientStop Offset="1" Color="#FA041417" />
            </LinearGradientBrush>
            <x:Double x:Key="StudioArtworkOpacity">0.52</x:Double>
            <x:Double x:Key="StudioWorkspaceArtworkOpacity">0.42</x:Double>
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#35D8DF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#56E1E9" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#25AAB0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#4D35D8DF" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#041417" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#041417" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#041417" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#99041417" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#35D8DF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="StudioBackgroundBrush" Color="#EDF7F7" />
            <SolidColorBrush x:Key="StudioCardBrush" Color="#EFFFFFFF" />
            <SolidColorBrush x:Key="StudioBorderBrush" Color="#5930A9B1" />
            <SolidColorBrush x:Key="StudioTextBrush" Color="#102426" />
            <SolidColorBrush x:Key="StudioMutedTextBrush" Color="#536864" />
            <SolidColorBrush x:Key="StudioAccentBrush" Color="#087F88" />
            <SolidColorBrush x:Key="StudioAccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="#416C94" />
            <SolidColorBrush x:Key="StudioSuccessBrush" Color="#147A59" />
            <SolidColorBrush x:Key="StudioDangerBrush" Color="#B23527" />
            <SolidColorBrush x:Key="StudioNavigationPaneBrush" Color="#F5E5F1F1" />
            <SolidColorBrush x:Key="StudioLogoPanelBrush" Color="#EFFFFFFF" />
            <SolidColorBrush x:Key="StudioTitleBarBrush" Color="#DDE5F1F1" />
            <LinearGradientBrush x:Key="StudioContentScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#C7EDF7F7" />
                <GradientStop Offset="0.38" Color="#EDEDF7F7" />
                <GradientStop Offset="1" Color="#FCEDF7F7" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="StudioWorkspaceScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#B8EDF7F7" />
                <GradientStop Offset="0.42" Color="#ECEDF7F7" />
                <GradientStop Offset="1" Color="#FDEDF7F7" />
            </LinearGradientBrush>
            <x:Double x:Key="StudioArtworkOpacity">0.25</x:Double>
            <x:Double x:Key="StudioWorkspaceArtworkOpacity">0.22</x:Double>
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#006A6E" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#00858A" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#004F52" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#4D006A6E" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#006A6E" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="StudioBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StudioCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StudioBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StudioTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StudioMutedTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="StudioAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StudioAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StudioSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StudioDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StudioNavigationPaneBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StudioLogoPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StudioTitleBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StudioContentScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StudioWorkspaceScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <x:Double x:Key="StudioArtworkOpacity">0</x:Double>
            <x:Double x:Key="StudioWorkspaceArtworkOpacity">0</x:Double>
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="SystemControlHighlightAccentBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="SystemControlForegroundAccentBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="SystemControlBackgroundBaseMediumLowBrush" />
            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="SystemControlBackgroundBaseLowBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="SystemControlHighlightAltAccentBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="SystemControlBackgroundChromeWhiteBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="SystemControlHighlightBaseHighBrush" />
            <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />
            <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="SystemColorHighlightTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
