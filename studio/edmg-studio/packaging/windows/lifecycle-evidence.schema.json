{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edmg.invalid/schemas/msix-lifecycle-evidence-v4.json",
  "title": "EDMG Studio MSIX lifecycle qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "packageIdentity",
    "artifacts",
    "dataPolicy",
    "scenario",
    "status",
    "startedAt",
    "completedAt",
    "receipts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "candidateId": {
      "type": "string",
      "pattern": "^edmg-rc1-[a-f0-9]{64}$"
    },
    "packageIdentity": {
      "$ref": "#/$defs/identity"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "upgrade",
        "rollback"
      ],
      "properties": {
        "install": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifact"
            }
          ]
        },
        "upgrade": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifact"
            }
          ]
        },
        "rollback": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifact"
            }
          ]
        }
      }
    },
    "candidateArtifact": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }]
    },
    "interactiveReceipt": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/interactiveReceipt"
        }
      ]
    },
    "dataPolicy": {
      "enum": [
        "retain",
        "remove"
      ]
    },
    "scenario": {
      "enum": [
        "CleanInstall",
        "Upgrade",
        "Repair",
        "Rollback",
        "Uninstall",
        "Full"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "passed",
        "failed",
        "incomplete"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string"
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanInstall",
        "firstRunNativeFlow",
        "projectPersistence",
        "autosaveRecovery",
        "upgrade",
        "repair",
        "rollback",
        "uninstall"
      ],
      "properties": {
        "cleanInstall": {
          "$ref": "#/$defs/receipt"
        },
        "firstRunNativeFlow": {
          "$ref": "#/$defs/receipt"
        },
        "projectPersistence": {
          "$ref": "#/$defs/receipt"
        },
        "autosaveRecovery": {
          "$ref": "#/$defs/receipt"
        },
        "upgrade": {
          "$ref": "#/$defs/receipt"
        },
        "repair": {
          "$ref": "#/$defs/receipt"
        },
        "rollback": {
          "$ref": "#/$defs/receipt"
        },
        "uninstall": {
          "$ref": "#/$defs/receipt"
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "publisher",
        "version",
        "architecture"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "const": "x64"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "bytes",
        "sha256",
        "identity"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "interactiveReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "testedPackageSha256",
        "packageIdentity",
        "executedAt",
        "evidenceReference",
        "evidenceSha256"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^edmg-rc1-[a-f0-9]{64}$"
        },
        "testedPackageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packageIdentity": {
          "$ref": "#/$defs/identity"
        },
        "executedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceReference": {
          "type": "string",
          "minLength": 1
        },
        "evidenceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "observedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-run",
            "passed",
            "failed"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    }
  }
}
