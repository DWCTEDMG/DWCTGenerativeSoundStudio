# EDMG Studio (Desktop) runtime env defaults

# Backend
EDMG_STUDIO_DATA_DIR=./data
EDMG_STUDIO_BACKEND_HOST=127.0.0.1
EDMG_STUDIO_BACKEND_PORT=7863
VITE_EDMG_BACKEND_URL=http://127.0.0.1:7863
EDMG_DIRECTOR_HOST=127.0.0.1
EDMG_DIRECTOR_PORT=3001
# Optional if you expose the managed Director app over HTTPS for ChatGPT:
# EDMG_DIRECTOR_BASE_URL=https://your-public-director-host

# AI (default: NVIDIA Nemotron cloud via nemotron_cloud / OpenAI-compatible NIM)
EDMG_AI_MODE=local
EDMG_AI_PROVIDER=nemotron_cloud
# Optional local Ollama planner instead:
# EDMG_AI_PROVIDER=ollama
# EDMG_AI_OLLAMA_URL=http://127.0.0.1:11434
# EDMG_AI_OLLAMA_MODEL=nemotron-3-ultra:cloud
# Low-resource local fallback: EDMG_AI_OLLAMA_MODEL=qwen3:4b
# NVIDIA NIM / OpenAI-compatible override:
# EDMG_AI_PROVIDER=openai_compat
# EDMG_AI_OPENAI_COMPAT_BASE_URL=https://integrate.api.nvidia.com/v1
# EDMG_AI_OPENAI_COMPAT_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ComfyUI
EDMG_COMFYUI_URL=http://127.0.0.1:8188
# Multi-node example:
# EDMG_COMFYUI_URLS=http://127.0.0.1:8188,http://192.168.1.50:8188

# FFmpeg (Option B): install FFmpeg and ensure it's on PATH, or set EDMG_FFMPEG_PATH to the ffmpeg executable.
EDMG_FFMPEG_PATH=ffmpeg

# Optional tokens (recommended to set via Studio Settings → Tokens)
# HF_TOKEN=
# CIVITAI_API_KEY=

# Optional S3-backed model hosting / cache
# Requires AWS credentials through the normal AWS provider chain or env vars.
# EDMG_AWS_MODEL_CACHE=1
# EDMG_AWS_MODEL_CACHE_BUCKET=your-model-bucket
# EDMG_AWS_MODEL_CACHE_PREFIX=models
# EDMG_MODEL_STORAGE_MODE=local_cache
# Use cloud_only to store supported model files and internal snapshots in S3 without keeping a local copy:
# EDMG_MODEL_STORAGE_MODE=cloud_only
# Optional S3-compatible endpoint:
# EDMG_S3_ENDPOINT_URL=https://s3-compatible.example.com

# Optional Hugging Face bucket-backed model hosting / cache
# Auth uses the locally saved token from `hf auth login` (no token stored here).
# Project defaults also ship in launcher_env.defaults.json (loaded at startup);
# real env vars and a local launcher_env.json override these.
EDMG_HF_BUCKET_MODEL_CACHE=1
EDMG_HF_BUCKET_ID=gulle1155/DWCTedmgAIStudioModels
EDMG_HF_BUCKET_PREFIX=
# Keep a local model copy and mirror supported installs to the configured bucket.
EDMG_MODEL_STORAGE_MODE=local_cache
# Pinned by the backend project; enables accelerated non-Xet Hub downloads.
HF_HUB_ENABLE_HF_TRANSFER=1
# Bound hf_transfer's otherwise hard-coded 100-way concurrency for desktop networks.
EDMG_HF_TRANSFER_CONCURRENCY=4
